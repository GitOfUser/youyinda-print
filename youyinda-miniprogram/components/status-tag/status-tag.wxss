.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-weight: 500;
  line-height: 1.4;
  gap: 6rpx;
}

.status-tag.small {
  padding: 4rpx 16rpx;
  font-size: var(--fs-xs);
  border-radius: var(--radius-sm);
}

.status-tag.medium {
  padding: 8rpx 20rpx;
  font-size: var(--fs-sm);
}

.status-tag.large {
  padding: 12rpx 28rpx;
  font-size: var(--fs-base);
}

.status-tag.round {
  border-radius: var(--radius-full);
}

.status-tag.small.round {
  padding: 4rpx 16rpx;
}

.status-tag.medium.round {
  padding: 8rpx 24rpx;
}

.status-tag.large.round {
  padding: 12rpx 32rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-tag.pending,
.status-tag.warning {
  background: var(--warning-light);
  color: var(--warning);
}

.status-tag.processing,
.status-tag.info {
  background: var(--info-light);
  color: var(--info);
}

.status-tag.completed,
.status-tag.success {
  background: var(--success-light);
  color: var(--success);
}

.status-tag.cancelled,
.status-tag.default,
.status-tag.gray {
  background: #F3F4F6;
  color: var(--text-secondary);
}

.status-tag.exception,
.status-tag.danger {
  background: var(--danger-light);
  color: var(--danger);
}

.status-tag.primary {
  background: var(--primary-light);
  color: var(--primary);
}

.status-tag.print {
  background: var(--print-primary-light);
  color: var(--print-primary);
}

.status-tag.plain {
  background: transparent;
  border: 2rpx solid currentColor;
}
