.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-container.empty-fixed {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  box-sizing: border-box;
  padding: 60rpx;
}

.empty-icon-wrapper {
  margin-bottom: var(--spacing-lg);
}

.empty-icon-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: var(--fs-md);
  color: var(--text-body);
  font-weight: 500;
  margin-bottom: var(--spacing-xs);
}

.empty-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  max-width: 480rpx;
}

.empty-btn {
  margin-top: var(--spacing-xl);
  padding: 0 var(--spacing-xl);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-gradient);
  color: var(--white);
  font-size: var(--fs-base);
  font-weight: 500;
  border-radius: var(--radius-full);
  box-shadow: var(--primary-shadow);
  transition: all 0.2s ease;
}

.empty-btn.btn-print {
  background: var(--print-gradient);
  box-shadow: var(--print-shadow);
}

.empty-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
