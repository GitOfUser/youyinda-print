.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--white);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
}

.custom-navbar.navbar-transparent {
  background: transparent !important;
  box-shadow: none;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 var(--spacing-md);
}

.back-btn {
  position: absolute;
  left: var(--spacing-md);
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  z-index: 10;
}

.back-btn.back-capsule {
  background: rgba(255,255,255,0.25);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-full);
  padding: 0 var(--spacing-md);
  width: auto;
  min-width: 64rpx;
  height: 56rpx;
}

.back-btn:active {
  transform: translateY(-50%) scale(0.92);
  opacity: 0.8;
}

.back-icon {
  font-size: 32rpx;
  color: var(--text-title);
  font-weight: 600;
}

.title-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-title);
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.right-slot {
  position: absolute;
  right: var(--spacing-md);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  z-index: 10;
}

.navbar-placeholder {
  width: 100%;
}
