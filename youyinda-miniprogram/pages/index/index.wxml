<view class="container">
  <view class="header-section">
    <view class="location-bar">
      <view class="location">
        <text class="location-icon">📍</text>
        <text class="location-text">当前位置</text>
        <text class="location-arrow">▼</text>
      </view>
      <view class="header-actions">
        <text class="action-icon">🔔</text>
      </view>
    </view>
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索打印店、快递服务</text>
    </view>
  </view>

  <view class="banner-section">
    <view class="banner-card">
      <view class="banner-content">
        <view class="banner-title">新用户专享</view>
        <view class="banner-subtitle">首单立减5元</view>
      </view>
      <view class="banner-tag">立即领取</view>
    </view>
  </view>

  <view class="main-entrance">
    <view class="entrance-card print-card" bindtap="goToPrint">
      <view class="entrance-icon-wrap print-icon-wrap">
        <text class="entrance-icon-text">🖨️</text>
      </view>
      <view class="entrance-info">
        <view class="entrance-title">文档打印</view>
        <view class="entrance-desc">上传文件 极速送达</view>
      </view>
      <view class="entrance-arrow">›</view>
    </view>

    <view class="entrance-card express-card" bindtap="goToExpress">
      <view class="entrance-icon-wrap express-icon-wrap">
        <text class="entrance-icon-text">📦</text>
      </view>
      <view class="entrance-info">
        <view class="entrance-title">低价寄快递</view>
        <view class="entrance-desc">全网比价 上门取件</view>
      </view>
      <view class="entrance-arrow">›</view>
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <view class="section-title">快捷服务</view>
    </view>
    <view class="service-grid">
      <view class="service-item" bindtap="goToOrderList">
        <view class="service-icon-wrap orange-bg">
          <text class="service-icon">📋</text>
        </view>
        <view class="service-text">我的订单</view>
      </view>
      <view class="service-item" bindtap="goToAddress">
        <view class="service-icon-wrap blue-bg">
          <text class="service-icon">📍</text>
        </view>
        <view class="service-text">地址簿</view>
      </view>
      <view class="service-item" bindtap="goToCoupon">
        <view class="service-icon-wrap red-bg">
          <text class="service-icon">🎫</text>
        </view>
        <view class="service-text">优惠券</view>
      </view>
      <view class="service-item" bindtap="goToHelp">
        <view class="service-icon-wrap gray-bg">
          <text class="service-icon">❓</text>
        </view>
        <view class="service-text">帮助中心</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <view class="section-title">限时活动</view>
    </view>
    <view class="promotion-list">
      <view class="promotion-item">
        <view class="promotion-tag new-tag">新用户</view>
        <view class="promotion-content">
          <view class="promotion-title">首单立减5元</view>
          <view class="promotion-desc">新用户专享，打印/快递通用</view>
        </view>
        <view class="promotion-arrow">›</view>
      </view>
      <view class="promotion-item">
        <view class="promotion-tag hot-tag">热门</view>
        <view class="promotion-content">
          <view class="promotion-title">邀请好友得现金</view>
          <view class="promotion-desc">每邀请1位好友，双方各得3元</view>
        </view>
        <view class="promotion-arrow">›</view>
      </view>
    </view>
  </view>
</view>
