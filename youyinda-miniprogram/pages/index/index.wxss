.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: 120rpx;
}

/* 顶部区域 */
.header-section {
  background: var(--white);
  padding: var(--spacing-md) var(--page-margin);
  padding-bottom: var(--spacing-lg);
}

.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.location {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.location-icon {
  font-size: 32rpx;
}

.location-text {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--text-title);
}

.location-arrow {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.action-icon {
  font-size: 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  height: 76rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-full);
  padding: 0 var(--spacing-lg);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.6;
}

.search-placeholder {
  font-size: var(--fs-sm);
  color: var(--text-hint);
}

/* Banner区域 */
.banner-section {
  padding: var(--spacing-lg) var(--page-margin);
}

.banner-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FF7D00 0%, #FF9A3C 100%);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-xl);
  box-shadow: 0 8rpx 24rpx rgba(255,125,0,0.25);
}

.banner-content {
  color: white;
}

.banner-title {
  font-size: var(--fs-md);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: var(--fs-xl);
  font-weight: 700;
}

.banner-tag {
  background: rgba(255,255,255,0.25);
  color: white;
  font-size: var(--fs-sm);
  font-weight: 500;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
}

/* 主要服务入口 */
.main-entrance {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: 0 var(--page-margin) var(--spacing-md);
}

.entrance-card {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

.print-card {
  border-left: 8rpx solid var(--print-primary);
}

.express-card {
  border-left: 8rpx solid var(--express-primary);
}

.entrance-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-lg);
}

.print-icon-wrap {
  background: var(--print-primary-light);
}

.express-icon-wrap {
  background: var(--express-primary-light);
}

.entrance-icon-text {
  font-size: 48rpx;
}

.entrance-info {
  flex: 1;
}

.entrance-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--text-title);
  margin-bottom: 8rpx;
}

.entrance-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.entrance-arrow {
  font-size: 48rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--text-title);
}

/* 服务网格 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-lg) 0;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}

.orange-bg {
  background: var(--primary-light);
}

.blue-bg {
  background: var(--print-primary-light);
}

.red-bg {
  background: var(--danger-light);
}

.gray-bg {
  background: var(--bg-gray);
}

.service-icon {
  font-size: 40rpx;
}

.service-text {
  font-size: var(--fs-xs);
  color: var(--text-body);
}

/* 活动列表 */
.promotion-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.promotion-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  background: var(--bg-cream);
  border-radius: var(--radius-md);
}

.promotion-tag {
  color: white;
  font-size: var(--fs-xs);
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-xs);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.new-tag {
  background: var(--print-primary);
}

.hot-tag {
  background: var(--danger);
}

.promotion-content {
  flex: 1;
}

.promotion-title {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.promotion-desc {
  font-size: var(--fs-xs);
  color: var(--text-secondary);
}

.promotion-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}
