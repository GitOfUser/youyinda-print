/* 首页：仅结构性样式，颜色/字号/圆角一律引用 app.wxss 变量 */

/* 顶部头部 */
.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  padding: var(--s-lg) var(--page-margin) var(--s-md);
}

.greeting {
  flex: 1;
  min-width: 0;
}

.greeting-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--t1);
  margin-bottom: 8rpx;
}

.greeting-sub {
  font-size: var(--fs-sm);
  color: var(--t3);
}

.bell-tile {
  margin-left: var(--s-md);
}

/* 品牌渐变 Banner */
.banner-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--s-md) var(--page-margin);
  padding: var(--s-xl) var(--s-lg);
  border-radius: var(--r-lg);
  background: var(--brand-gradient);
  box-shadow: var(--brand-shadow);
}

.banner-deco {
  position: absolute;
  border-radius: 50%;
  background: var(--white);
  opacity: 0.12;
  pointer-events: none;
}

.banner-deco-1 {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.banner-deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -40rpx;
  left: -30rpx;
  opacity: 0.08;
}

.banner-body {
  position: relative;
  z-index: 1;
}

.banner-title {
  color: var(--white);
  font-size: var(--fs-md);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  color: var(--white);
  font-size: var(--fs-xl);
  font-weight: 700;
}

.banner-capsule {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: var(--s-md);
  padding: 14rpx 28rpx;
  border: 2rpx solid var(--white);
  border-radius: var(--r-full);
  color: var(--white);
  font-size: var(--fs-sm);
  font-weight: 500;
}

/* 双服务主入口 */
.entrance-row {
  display: flex;
  gap: var(--s-md);
  padding: 0 var(--page-margin) var(--s-md);
}

.entrance-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: var(--s-lg) var(--s-md);
}

.entrance-tile {
  margin-bottom: var(--s-sm);
}

.entrance-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--t1);
  margin-bottom: 6rpx;
}

.entrance-desc {
  font-size: var(--fs-xs);
  color: var(--t3);
}

/* 快捷服务网格 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-lg) 0;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.service-text {
  margin-top: var(--s-xs);
  font-size: var(--fs-sm);
  color: var(--t2);
}

/* 限时活动 */
.promotion-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-md);
}

.promotion-item {
  display: flex;
  align-items: center;
  padding: var(--s-md);
  background: var(--fill);
  border-radius: var(--r-md);
}

.promotion-tag {
  flex-shrink: 0;
  margin-right: var(--s-md);
}

.promotion-content {
  flex: 1;
  min-width: 0;
}

.promotion-title {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 4rpx;
}

.promotion-desc {
  font-size: var(--fs-xs);
  color: var(--t3);
}

.promotion-arrow {
  flex-shrink: 0;
}
