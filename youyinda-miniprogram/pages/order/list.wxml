<view class="container">
  <view class="tab-bar">
    <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="index" bindtap="switchTab" data-index="{{index}}">
      <text>{{item}}</text>
      <view class="tab-line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <view class="order-list">
    <view class="order-card card" wx:for="{{orderList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <view class="order-no">订单号：{{item.orderNo}}</view>
        <view class="order-status status-{{item.statusType}}">{{item.statusText}}</view>
      </view>

      <view class="order-goods">
        <view class="goods-item" wx:for="{{item.goods}}" wx:key="id" wx:for-item="goods">
          <view class="goods-icon-wrap">
            <text class="goods-icon">{{goods.type === 'print' ? '🖨️' : '📦'}}</text>
          </view>
          <view class="goods-info">
            <view class="goods-name">{{goods.name}}</view>
            <view class="goods-desc">{{goods.desc}}</view>
          </view>
          <view class="goods-qty">x{{goods.quantity}}</view>
        </view>
      </view>

      <view class="order-footer">
        <view class="order-time">{{item.createTime}}</view>
        <view class="order-price-wrap">
          <text class="order-price-label">共{{item.totalCount}}件商品 合计：</text>
          <text class="order-price">¥{{item.totalPrice}}</text>
        </view>
      </view>

      <view class="order-actions" wx:if="{{item.actions.length > 0}}">
        <view class="action-btn btn-secondary" wx:for="{{item.actions}}" wx:key="type" wx:for-item="action" bindtap="handleAction" data-type="{{action.type}}" data-id="{{item.id}}" catchtap>
          {{action.text}}
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{orderList.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <text class="empty-desc">快去下单享受服务吧</text>
    <view class="empty-btn" bindtap="goToHome">去下单</view>
  </view>
</view>
