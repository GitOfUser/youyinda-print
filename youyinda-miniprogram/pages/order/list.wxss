.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: var(--spacing-xl);
}

.tab-bar {
  display: flex;
  background: var(--white);
  padding: 0 var(--page-margin);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) 0;
  font-size: var(--fs-base);
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.order-list {
  padding-top: var(--spacing-md);
}

.order-card {
  margin-bottom: var(--spacing-md);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--divider);
}

.order-no {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.order-status {
  font-size: var(--fs-sm);
  font-weight: 500;
}

.status-pending {
  color: var(--danger);
}

.status-processing {
  color: var(--warning);
}

.status-completed {
  color: var(--success);
}

.status-cancelled {
  color: var(--text-secondary);
}

.order-goods {
  padding: var(--spacing-md) 0;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.goods-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.goods-icon {
  font-size: 44rpx;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-qty {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--divider);
}

.order-time {
  font-size: var(--fs-xs);
  color: var(--text-hint);
}

.order-price-wrap {
  display: flex;
  align-items: baseline;
}

.order-price-label {
  font-size: var(--fs-sm);
  color: var(--text-body);
}

.order-price {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--primary);
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-md);
  margin-top: var(--spacing-md);
  border-top: 1rpx solid var(--divider);
}

.action-btn {
  height: 64rpx;
  padding: 0 28rpx;
  font-size: var(--fs-sm);
}

.action-btn.primary {
  background: var(--primary-gradient);
  color: white;
  border: none;
  box-shadow: var(--primary-shadow);
}
