.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: var(--s-xl);
}

.tab-bar {
  display: flex;
  background: var(--card);
  padding: 0 var(--page-margin);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s-lg) 0;
  font-size: var(--fs-base);
  color: var(--t3);
  position: relative;
}

.tab-item.active {
  color: var(--brand);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: var(--brand-gradient);
  border-radius: 3rpx;
}

.order-list {
  padding-top: var(--s-md);
}

.order-card {
  margin-bottom: var(--s-md);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--s-md);
  border-bottom: 1rpx solid var(--line);
}

.order-meta {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
  min-width: 0;
}

.tag .tag-text {
  margin-left: 4rpx;
}

.order-no {
  font-size: var(--fs-sm);
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-goods {
  padding: var(--s-md) 0;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: var(--s-sm) 0;
}

.goods-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: var(--fill);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--s-md);
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: var(--fs-base);
  color: var(--t1);
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-qty {
  font-size: var(--fs-sm);
  color: var(--t2);
  flex-shrink: 0;
  margin-left: var(--s-sm);
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--s-md);
  border-top: 1rpx solid var(--line);
}

.order-time {
  font-size: var(--fs-xs);
  color: var(--t3);
}

.order-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.order-price-label {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.order-price {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--brand);
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: var(--s-sm);
  padding-top: var(--s-md);
  margin-top: var(--s-md);
  border-top: 1rpx solid var(--line);
}
