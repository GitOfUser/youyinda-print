.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: 0;
}

.status-banner {
  background: var(--white);
  padding: var(--spacing-xl) var(--page-margin);
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.status-icon {
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.status-info {
  flex: 1;
}

.status-text {
  font-size: var(--fs-xl);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.status-pending {
  color: var(--danger);
}

.status-processing {
  color: var(--warning);
}

.status-completed {
  color: var(--success);
}

.status-cancelled {
  color: var(--text-secondary);
}

.status-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.address-section {
  padding: var(--spacing-sm) 0;
}

.address-row {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-md) 0;
}

.address-tag {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: white;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.sender-tag {
  background: var(--primary);
}

.receiver-tag {
  background: var(--print-primary);
}

.address-info {
  flex: 1;
}

.address-contact {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: 8rpx;
}

.contact-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
}

.contact-phone {
  font-size: var(--fs-base);
  color: var(--text-body);
}

.address-detail {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

.address-line {
  height: 1rpx;
  background: var(--divider);
  margin-left: 64rpx;
}

.track-list {
  padding-left: var(--spacing-sm);
}

.track-item {
  display: flex;
  position: relative;
  padding-bottom: var(--spacing-lg);
}

.track-item:last-child {
  padding-bottom: 0;
}

.track-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border);
  margin-right: var(--spacing-md);
  margin-top: 8rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.track-item.active .track-dot {
  background: var(--primary);
  box-shadow: 0 0 0 6rpx var(--primary-light);
}

.track-line {
  position: absolute;
  left: 7rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--border);
}

.track-content {
  flex: 1;
  padding-bottom: var(--spacing-sm);
}

.track-desc {
  font-size: var(--fs-base);
  color: var(--text-body);
  margin-bottom: 8rpx;
}

.track-item.active .track-desc {
  color: var(--text-title);
  font-weight: 500;
}

.track-time {
  font-size: var(--fs-xs);
  color: var(--text-hint);
}

.info-list {
  padding: var(--spacing-sm) 0;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.goods-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.goods-icon {
  font-size: 44rpx;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.goods-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.goods-price {
  text-align: right;
  flex-shrink: 0;
}

.goods-price .price {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.goods-price .qty {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.fee-list {
  padding-top: var(--spacing-md);
}

.fee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
}

.fee-label {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.fee-value {
  font-size: var(--fs-base);
  color: var(--text-body);
}

.detail-list {
  padding: var(--spacing-sm) 0;
}

.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) 0;
}

.detail-label {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
}

.detail-value-wrap {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.detail-value {
  font-size: var(--fs-base);
  color: var(--text-title);
  text-align: right;
}

.copy-btn {
  font-size: var(--fs-sm);
  color: var(--primary);
  padding: 4rpx 16rpx;
  background: var(--primary-light);
  border-radius: var(--radius-xs);
}

.bottom-bar-actions {
  display: flex;
  gap: var(--spacing-sm);
}
