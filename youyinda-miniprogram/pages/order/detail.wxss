.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 0;
}

.status-banner {
  background: var(--brand-gradient);
  padding: var(--s-xl) var(--page-margin) var(--s-lg);
  padding-top: calc(var(--s-xl) + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  gap: var(--s-lg);
  margin-bottom: var(--s-md);
}

.banner-icon {
  width: 112rpx;
  height: 112rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner-info {
  flex: 1;
  min-width: 0;
}

.banner-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: 8rpx;
}

.banner-desc {
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, 0.85);
}

.address-row {
  display: flex;
  align-items: flex-start;
  padding: var(--s-md) 0;
}

.address-tag {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--white);
  margin-right: var(--s-md);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.sender-tag {
  background: var(--brand);
}

.receiver-tag {
  background: var(--express);
}

.address-info {
  flex: 1;
}

.address-contact {
  display: flex;
  align-items: center;
  gap: var(--s-md);
  margin-bottom: 8rpx;
}

.contact-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.contact-phone {
  font-size: var(--fs-base);
  color: var(--t2);
}

.address-detail {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.6;
}

.address-line {
  height: 1rpx;
  background: var(--line);
  margin-left: 64rpx;
}

.track-list {
  padding-left: var(--s-sm);
}

.track-item {
  display: flex;
  position: relative;
  padding-bottom: var(--s-lg);
}

.track-item:last-child {
  padding-bottom: 0;
}

.track-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border);
  margin-right: var(--s-md);
  margin-top: 8rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.track-item.active .track-dot {
  background: var(--brand);
  box-shadow: 0 0 0 6rpx var(--brand-light);
}

.track-line {
  position: absolute;
  left: 7rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--border);
}

.track-content {
  flex: 1;
  padding-bottom: var(--s-sm);
}

.track-desc {
  font-size: var(--fs-base);
  color: var(--t2);
  margin-bottom: 8rpx;
}

.track-item.active .track-desc {
  color: var(--t1);
  font-weight: 500;
}

.track-time {
  font-size: var(--fs-xs);
  color: var(--t3);
}

.goods-item {
  display: flex;
  align-items: center;
  padding: var(--s-sm) 0;
}

.goods-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: var(--fill);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--s-md);
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: var(--fs-base);
  color: var(--t1);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.goods-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.goods-price {
  text-align: right;
  flex-shrink: 0;
}

.goods-price .price {
  font-size: var(--fs-base);
  color: var(--t1);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.goods-price .qty {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.fee-list {
  padding-top: var(--s-md);
}

.fee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-sm) 0;
}

.fee-label {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.fee-value {
  font-size: var(--fs-base);
  color: var(--t2);
}

.detail-list {
  padding: var(--s-sm) 0;
}

.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-md) 0;
}

.detail-label {
  font-size: var(--fs-sm);
  color: var(--t2);
  flex-shrink: 0;
}

.detail-value-wrap {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}

.detail-value {
  font-size: var(--fs-base);
  color: var(--t1);
  text-align: right;
}

.copy-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--fs-sm);
  color: var(--brand);
  padding: 6rpx 16rpx;
  background: var(--brand-light);
  border-radius: var(--r-xs);
}

.bottom-bar-actions {
  display: flex;
  gap: var(--s-sm);
}
