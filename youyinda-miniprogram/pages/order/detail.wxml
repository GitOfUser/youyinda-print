<view class="container">
  <view class="status-banner">
    <view class="status-icon">{{orderDetail.statusIcon}}</view>
    <view class="status-info">
      <view class="status-text status-{{orderDetail.statusType}}">{{orderDetail.statusText}}</view>
      <view class="status-desc">{{orderDetail.statusDesc}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{orderDetail.type === 'express'}}">
    <view class="card-header">
      <view class="card-title">收寄信息</view>
    </view>
    <view class="address-section">
      <view class="address-row">
        <view class="address-tag sender-tag">寄</view>
        <view class="address-info">
          <view class="address-contact">
            <text class="contact-name">{{orderDetail.sender.name}}</text>
            <text class="contact-phone">{{orderDetail.sender.phone}}</text>
          </view>
          <view class="address-detail">{{orderDetail.sender.address}}</view>
        </view>
      </view>
      <view class="address-line"></view>
      <view class="address-row">
        <view class="address-tag receiver-tag">收</view>
        <view class="address-info">
          <view class="address-contact">
            <text class="contact-name">{{orderDetail.receiver.name}}</text>
            <text class="contact-phone">{{orderDetail.receiver.phone}}</text>
          </view>
          <view class="address-detail">{{orderDetail.receiver.address}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{orderDetail.trackInfo}}">
    <view class="card-header">
      <view class="card-title">物流轨迹</view>
      <view class="btn-text" bindtap="goToTrack">查看完整轨迹</view>
    </view>
    <view class="track-list">
      <view class="track-item {{index === 0 ? 'active' : ''}}" wx:for="{{orderDetail.trackInfo}}" wx:key="time">
        <view class="track-dot"></view>
        <view class="track-line" wx:if="{{index < orderDetail.trackInfo.length - 1}}"></view>
        <view class="track-content">
          <view class="track-desc">{{item.desc}}</view>
          <view class="track-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-title">订单信息</view>
    </view>
    <view class="info-list">
      <view class="goods-item" wx:for="{{orderDetail.goods}}" wx:key="id">
        <view class="goods-icon-wrap">
          <text class="goods-icon">{{item.type === 'print' ? '🖨️' : '📦'}}</text>
        </view>
        <view class="goods-info">
          <view class="goods-name">{{item.name}}</view>
          <view class="goods-desc">{{item.desc}}</view>
        </view>
        <view class="goods-price">
          <text class="price">¥{{item.price}}</text>
          <text class="qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
    <view class="line mt-md"></view>
    <view class="fee-list">
      <view class="fee-item">
        <text class="fee-label">商品金额</text>
        <text class="fee-value">¥{{orderDetail.goodsAmount}}</text>
      </view>
      <view class="fee-item" wx:if="{{orderDetail.discountAmount > 0}}">
        <text class="fee-label">优惠</text>
        <text class="fee-value text-danger">-¥{{orderDetail.discountAmount}}</text>
      </view>
      <view class="fee-item" wx:if="{{orderDetail.shippingFee > 0}}">
        <text class="fee-label">运费</text>
        <text class="fee-value">¥{{orderDetail.shippingFee}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-title">订单详情</view>
    </view>
    <view class="detail-list">
      <view class="detail-item">
        <text class="detail-label">订单编号</text>
        <view class="detail-value-wrap">
          <text class="detail-value">{{orderDetail.orderNo}}</text>
          <text class="copy-btn" bindtap="copyOrderNo">复制</text>
        </view>
      </view>
      <view class="detail-item">
        <text class="detail-label">下单时间</text>
        <text class="detail-value">{{orderDetail.createTime}}</text>
      </view>
      <view class="detail-item" wx:if="{{orderDetail.payTime}}">
        <text class="detail-label">支付时间</text>
        <text class="detail-value">{{orderDetail.payTime}}</text>
      </view>
      <view class="detail-item" wx:if="{{orderDetail.payMethod}}">
        <text class="detail-label">支付方式</text>
        <text class="detail-value">{{orderDetail.payMethod}}</text>
      </view>
      <view class="detail-item" wx:if="{{orderDetail.remark}}">
        <text class="detail-label">订单备注</text>
        <text class="detail-value">{{orderDetail.remark}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-bar-left">
      <view class="bottom-bar-price">
        <text class="bottom-bar-label">实付款：</text>
        <text class="bottom-bar-value">¥{{orderDetail.totalPrice}}</text>
      </view>
    </view>
    <view class="bottom-bar-actions">
      <view class="btn-secondary btn-sm" wx:for="{{orderDetail.actions}}" wx:key="type" wx:for-item="action" bindtap="handleAction" data-type="{{action.type}}" wx:if="{{!action.primary}}">
        {{action.text}}
      </view>
      <view class="btn-primary btn-sm" wx:for="{{orderDetail.actions}}" wx:key="type" wx:for-item="action" bindtap="handleAction" data-type="{{action.type}}" wx:if="{{action.primary}}">
        {{action.text}}
      </view>
    </view>
  </view>
  <view class="bottom-bar-placeholder"></view>
</view>
