<view class="container">
  <view class="card faq-card">
    <view class="card-header">
      <view class="card-title">常见问题</view>
    </view>
    <view class="faq-list">
      <view class="faq-item" wx:for="{{helpList}}" wx:key="question" wx:for-item="faq" wx:for-index="index" bindtap="toggleAnswer" data-index="{{index}}">
        <view class="faq-question">
          <text class="faq-badge">Q</text>
          <text class="question-text">{{faq.question}}</text>
          <icon class="faq-arrow {{faq.expanded ? 'expanded' : ''}}" name="chevron-down" size="{{32}}" color="#94A3B8" />
        </view>
        <view class="faq-answer" wx:if="{{faq.expanded}}">
          <text class="answer-text">{{faq.answer}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="contact-card card">
    <view class="contact-header">
      <view class="contact-title">没有找到答案？</view>
      <view class="contact-desc">联系客服，为您解决问题</view>
    </view>
    <view class="contact-btns">
      <view class="contact-btn online-btn" bindtap="contactService">
        <icon name="service" size="{{32}}" color="#4F46E5" />
        <text>在线客服</text>
      </view>
      <view class="contact-btn phone-btn" bindtap="makePhoneCall">
        <icon name="phone" size="{{32}}" color="#0D9488" />
        <text>电话客服</text>
      </view>
    </view>
  </view>
</view>
