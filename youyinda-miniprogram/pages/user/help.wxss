.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: var(--s-xl);
}

.faq-card {
  margin-top: var(--s-md);
}

.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  padding: var(--s-md) 0;
  border-bottom: 1rpx solid var(--line);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: flex-start;
}

.faq-badge {
  width: 40rpx;
  height: 40rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--r-xs);
  font-size: var(--fs-sm);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--s-sm);
  margin-top: 2rpx;
}

.question-text {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--t1);
  line-height: 1.6;
}

.faq-arrow {
  flex-shrink: 0;
  margin-left: var(--s-sm);
  margin-top: 4rpx;
  transition: transform 0.2s ease;
}

.faq-arrow.expanded {
  transform: rotate(180deg);
}

.faq-answer {
  padding-left: 56rpx;
  padding-top: var(--s-sm);
}

.answer-text {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.8;
}

.contact-card {
  margin-top: var(--s-xl);
}

.contact-header {
  text-align: center;
  margin-bottom: var(--s-lg);
}

.contact-title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}

.contact-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.contact-btns {
  display: flex;
  gap: var(--s-md);
}

.contact-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-sm);
  border-radius: var(--r-full);
  font-size: var(--fs-base);
  font-weight: 500;
}

.online-btn {
  background: var(--brand-light);
  color: var(--brand);
}

.phone-btn {
  background: var(--express-light);
  color: var(--express);
}
