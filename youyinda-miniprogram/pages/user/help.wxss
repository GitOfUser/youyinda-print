.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: var(--spacing-xl);
}

.search-section {
  background: var(--white);
  padding: var(--spacing-md) var(--page-margin);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  height: 80rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-full);
  padding: 0 var(--spacing-lg);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-title);
}

.search-placeholder {
  color: var(--text-hint);
}

.page-padding {
  padding: 0 var(--page-margin);
}

.section-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: var(--spacing-lg);
}

.quick-section {
  margin-top: var(--spacing-md);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-lg) 0;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: var(--spacing-sm);
}

.orange-bg {
  background: var(--primary-light);
}

.blue-bg {
  background: var(--print-primary-light);
}

.green-bg {
  background: var(--success-light);
}

.red-bg {
  background: var(--danger-light);
}

.quick-text {
  font-size: var(--fs-xs);
  color: var(--text-body);
}

.faq-section {
  margin-top: var(--spacing-md);
}

.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--divider);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: flex-start;
}

.faq-icon {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary);
  color: white;
  border-radius: 8rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--spacing-sm);
  margin-top: 2rpx;
}

.question-text {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-title);
  line-height: 1.6;
}

.faq-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  transition: transform 0.2s ease;
}

.faq-arrow.expanded {
  transform: rotate(90deg);
}

.faq-answer {
  padding-left: 56rpx;
  padding-top: var(--spacing-sm);
}

.answer-text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  line-height: 1.8;
}

.category-section {
  margin-top: var(--spacing-md);
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-card {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.category-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.category-icon {
  font-size: 36rpx;
}

.category-info {
  flex: 1;
}

.category-name {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--text-title);
  margin-bottom: 4rpx;
}

.category-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.category-arrow {
  font-size: var(--fs-lg);
  color: var(--text-hint);
  flex-shrink: 0;
}

.search-result {
  margin-top: var(--spacing-md);
}

.contact-card {
  margin-top: var(--spacing-xl);
}

.contact-header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.contact-title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: 8rpx;
}

.contact-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.contact-btns {
  display: flex;
  gap: var(--spacing-md);
}

.contact-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  border-radius: var(--radius-full);
  font-size: var(--fs-base);
  font-weight: 500;
}

.online-btn {
  background: var(--primary-light);
  color: var(--primary);
}

.phone-btn {
  background: var(--print-primary-light);
  color: var(--print-primary);
}

.btn-icon {
  font-size: var(--fs-lg);
}
