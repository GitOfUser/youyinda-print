.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: var(--s-xl);
}

.tab-bar {
  display: flex;
  background: var(--card);
  padding: 0 var(--page-margin);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s-lg) 0;
  font-size: var(--fs-base);
  color: var(--t3);
  position: relative;
}

.tab-item.active {
  color: var(--brand);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: var(--brand-gradient);
  border-radius: 3rpx;
}

.coupon-list {
  padding: var(--s-lg) var(--page-margin);
}

.coupon-card {
  display: flex;
  background: var(--card);
  border-radius: var(--r-lg);
  margin-bottom: var(--s-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  position: relative;
}

.coupon-disabled {
  filter: grayscale(1);
  opacity: 0.65;
}

.coupon-left {
  width: 220rpx;
  background: var(--brand-gradient);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--s-lg) 0;
  position: relative;
  flex-shrink: 0;
}

.coupon-left::before,
.coupon-left::after {
  content: '';
  position: absolute;
  right: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--bg);
  border-radius: 50%;
}

.coupon-left::before {
  top: -12rpx;
}

.coupon-left::after {
  bottom: -12rpx;
}

.coupon-price {
  display: flex;
  align-items: baseline;
  color: var(--white);
}

.currency {
  font-size: var(--fs-base);
  font-weight: 600;
}

.amount {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-condition {
  font-size: var(--fs-xs);
  color: rgba(255, 255, 255, 0.9);
  margin-top: var(--s-sm);
}

.coupon-right {
  flex: 1;
  padding: var(--s-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: 2rpx dashed var(--border);
  margin-left: -1rpx;
}

.coupon-info {
  flex: 1;
  padding-right: var(--s-md);
  min-width: 0;
}

.coupon-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: var(--fs-xs);
  color: var(--t3);
}

.coupon-btn-disabled {
  padding: 12rpx 28rpx;
  background: var(--fill);
  color: var(--t3);
  font-size: var(--fs-sm);
  font-weight: 500;
  border-radius: var(--r-full);
  flex-shrink: 0;
}
