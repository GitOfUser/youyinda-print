.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: var(--spacing-xl);
}

.tab-bar {
  display: flex;
  background: var(--white);
  padding: 0 var(--page-margin);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) 0;
  font-size: var(--fs-base);
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.coupon-list {
  padding: var(--spacing-lg) var(--page-margin);
}

.coupon-card {
  display: flex;
  background: var(--white);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  position: relative;
}

.coupon-card.used {
  opacity: 0.6;
}

.coupon-left {
  width: 220rpx;
  background: var(--primary-gradient);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
  position: relative;
}

.coupon-left::before,
.coupon-left::after {
  content: '';
  position: absolute;
  right: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--bg-cream);
  border-radius: 50%;
}

.coupon-left::before {
  top: -12rpx;
}

.coupon-left::after {
  bottom: -12rpx;
}

.coupon-price {
  display: flex;
  align-items: baseline;
  color: white;
}

.currency {
  font-size: var(--fs-base);
  font-weight: 600;
}

.amount {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-condition {
  font-size: var(--fs-xs);
  color: rgba(255,255,255,0.9);
  margin-top: var(--spacing-sm);
}

.coupon-right {
  flex: 1;
  padding: var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: 2rpx dashed var(--border);
  margin-left: -1rpx;
}

.coupon-info {
  flex: 1;
  padding-right: var(--spacing-md);
}

.coupon-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: var(--fs-xs);
  color: var(--text-hint);
}

.coupon-btn {
  padding: 12rpx 28rpx;
  background: var(--primary-gradient);
  color: white;
  font-size: var(--fs-sm);
  font-weight: 500;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.coupon-btn.disabled {
  background: var(--bg-gray);
  color: var(--text-hint);
}

.coupon-card.used .coupon-left {
  background: linear-gradient(135deg, #C9CDD4 0%, #E5E6EB 100%);
}
