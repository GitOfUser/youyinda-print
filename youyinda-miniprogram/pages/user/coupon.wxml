<view class="container">
  <view class="tab-bar">
    <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="index" bindtap="switchTab" data-index="{{index}}">
      <text>{{item}}</text>
      <view class="tab-line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <view class="coupon-list">
    <view class="coupon-card {{item.used ? 'used' : ''}}" wx:for="{{couponList}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-price">
          <text class="currency">¥</text>
          <text class="amount">{{item.amount}}</text>
        </view>
        <view class="coupon-condition">满{{item.minAmount}}可用</view>
      </view>
      <view class="coupon-right">
        <view class="coupon-info">
          <view class="coupon-name">{{item.name}}</view>
          <view class="coupon-desc">{{item.desc}}</view>
          <view class="coupon-time">有效期至 {{item.expireTime}}</view>
        </view>
        <view class="coupon-btn" wx:if="{{!item.used && !item.expired}}" bindtap="useCoupon" data-id="{{item.id}}">
          立即使用
        </view>
        <view class="coupon-btn disabled" wx:if="{{item.used}}">已使用</view>
        <view class="coupon-btn disabled" wx:if="{{item.expired && !item.used}}">已过期</view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{couponList.length === 0}}">
    <text class="empty-icon">🎫</text>
    <text class="empty-text">暂无优惠券</text>
    <text class="empty-desc">快去领取优惠券吧</text>
  </view>
</view>
