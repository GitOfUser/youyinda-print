.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 0;
}

.address-list {
  padding: var(--s-md) 0;
}

.address-card {
  display: flex;
  align-items: flex-start;
  gap: var(--s-md);
}

.select-radio {
  padding-top: var(--s-sm);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio.checked {
  border-color: var(--brand);
  background: var(--brand);
}

.address-info {
  flex: 1;
  min-width: 0;
}

.address-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--s-sm);
  margin-bottom: var(--s-sm);
}

.contact-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.contact-phone {
  font-size: var(--fs-base);
  color: var(--t2);
}

.address-detail {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.6;
}

.address-actions {
  display: flex;
  align-items: center;
  gap: var(--s-lg);
  padding-top: var(--s-md);
  margin-top: var(--s-md);
  border-top: 1rpx solid var(--line);
}

.action-item {
  display: flex;
  align-items: center;
  gap: var(--s-xs);
}

.action-text {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.bottom-bar .btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-xs);
}

.btn-label {
  color: var(--white);
  font-size: 30rpx;
  font-weight: 600;
}
