.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: 0;
}

.address-list {
  padding: var(--spacing-md) 0;
}

.address-card {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
}

.select-radio {
  padding-top: var(--spacing-sm);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.radio.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: white;
  border-radius: 50%;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.address-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.contact-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
}

.contact-phone {
  font-size: var(--fs-base);
  color: var(--text-body);
}

.default-tag {
  font-size: var(--fs-xs);
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
  font-weight: 500;
}

.address-detail {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

.address-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
  padding-top: var(--spacing-md);
  margin-top: var(--spacing-md);
  border-top: 1rpx solid var(--divider);
}

.action-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}
