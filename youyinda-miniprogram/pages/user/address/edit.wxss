.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: var(--s-md) 0 0;
}

.form-card {
  padding: 0;
}

.form-item {
  display: flex;
  align-items: flex-start;
  padding: var(--s-lg);
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.input-label {
  width: 180rpx;
  font-size: var(--fs-base);
  color: var(--t1);
  flex-shrink: 0;
  padding-top: var(--s-sm);
}

.required {
  color: var(--danger);
  margin-right: 4rpx;
}

.input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-base);
  color: var(--t1);
  padding-top: var(--s-sm);
}

.ph {
  color: var(--t3);
}

.textarea {
  min-height: 140rpx;
  line-height: 1.6;
  padding: var(--s-sm) var(--s-md);
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--s-sm);
}

.form-picker text {
  font-size: var(--fs-base);
  color: var(--t1);
}

.form-picker .ph {
  color: var(--t3);
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-lg);
}

.switch-label {
  font-size: var(--fs-base);
  color: var(--t1);
}

.tip-text {
  display: flex;
  align-items: center;
  gap: var(--s-xs);
  padding: var(--s-lg) var(--page-margin);
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.6;
}

.bottom-bar {
  display: flex;
  gap: var(--s-md);
}

.bottom-bar button {
  margin: 0;
}
