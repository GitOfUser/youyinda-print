.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding: var(--spacing-md) 0 0;
}

.form-card {
  padding: 0;
}

.form-item {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--divider);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: var(--fs-base);
  color: var(--text-title);
  flex-shrink: 0;
  padding-top: var(--spacing-sm);
}

.required {
  color: var(--danger);
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-title);
  padding-top: var(--spacing-sm);
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--spacing-sm);
}

.form-picker text {
  font-size: var(--fs-base);
  color: var(--text-title);
}

.form-picker .placeholder {
  color: var(--text-hint);
}

.picker-arrow {
  font-size: var(--fs-lg);
  color: var(--text-hint);
}

.form-textarea {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-title);
  min-height: 120rpx;
  padding-top: var(--spacing-sm);
  line-height: 1.6;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
}

.switch-label {
  font-size: var(--fs-base);
  color: var(--text-title);
}

.tip-text {
  padding: var(--spacing-lg) var(--page-margin);
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

.bottom-bar {
  display: flex;
  gap: var(--spacing-md);
}

.bottom-bar button {
  margin: 0;
}
