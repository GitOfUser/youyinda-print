<view class="container">
  <view class="card form-card">
    <view class="form-item">
      <view class="input-label"><text class="required">*</text>收货人</view>
      <input class="input" placeholder="请输入收货人姓名" placeholder-class="ph" value="{{formData.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <view class="input-label"><text class="required">*</text>手机号码</view>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号码" placeholder-class="ph" value="{{formData.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item">
      <view class="input-label"><text class="required">*</text>所在地区</view>
      <picker mode="region" bindchange="onRegionChange">
        <view class="form-picker">
          <text class="{{formData.regionText ? '' : 'ph'}}">{{formData.regionText || '请选择省/市/区'}}</text>
          <icon name="chevron-right" size="{{32}}" color="#94A3B8" />
        </view>
      </picker>
    </view>
    <view class="form-item">
      <view class="input-label"><text class="required">*</text>详细地址</view>
      <textarea class="input textarea" placeholder="请输入详细地址，如街道、门牌号等" placeholder-class="ph" value="{{formData.detail}}" bindinput="onInput" data-field="detail" maxlength="200" auto-height></textarea>
    </view>
  </view>

  <view class="card">
    <view class="switch-item">
      <text class="switch-label">设为默认地址</text>
      <switch checked="{{formData.isDefault}}" bindchange="onSwitchChange" color="#4F46E5" />
    </view>
  </view>

  <view class="tip-text">
    <icon name="info" size="{{28}}" color="#94A3B8" />
    <text>请填写准确的地址信息，以便快递员快速取件</text>
  </view>

  <view class="bottom-bar">
    <button class="btn-ghost" wx:if="{{addressId}}" bindtap="deleteAddress">删除地址</button>
    <button class="btn-primary flex-1" bindtap="saveAddress">保存</button>
  </view>
  <view class="bottom-bar-placeholder"></view>
</view>
