<view class="container">
  <view class="card form-card">
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text>收货人</text>
      </view>
      <input class="form-input" placeholder="请输入收货人姓名" value="{{formData.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text>手机号码</text>
      </view>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号码" value="{{formData.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item" bindtap="chooseRegion">
      <view class="form-label">
        <text class="required">*</text>
        <text>所在地区</text>
      </view>
      <view class="form-picker">
        <text class="{{formData.region ? '' : 'placeholder'}}">{{formData.region || '请选择省/市/区'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>
    <view class="form-item">
      <view class="form-label">
        <text class="required">*</text>
        <text>详细地址</text>
      </view>
      <textarea class="form-textarea" placeholder="请输入详细地址，如街道、门牌号等" value="{{formData.detail}}" bindinput="onInput" data-field="detail" maxlength="200" auto-height></textarea>
    </view>
  </view>

  <view class="card">
    <view class="switch-item">
      <text class="switch-label">设为默认地址</text>
      <switch checked="{{formData.isDefault}}" bindchange="onSwitchChange" color="#FF7D00" />
    </view>
  </view>

  <view class="tip-text">
    <text>💡 温馨提示：请填写准确的地址信息，以便快递员快速取件</text>
  </view>

  <view class="bottom-bar">
    <button class="btn-secondary" bindtap="deleteAddress" wx:if="{{addressId}}">删除地址</button>
    <button class="btn-primary flex-1" bindtap="saveAddress">保存</button>
  </view>
  <view class="bottom-bar-placeholder"></view>
</view>
