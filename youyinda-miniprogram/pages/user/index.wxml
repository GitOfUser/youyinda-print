<view class="container">
  <view class="user-header">
    <view class="user-info" bindtap="doLogin">
      <view class="avatar avatar-lg">
        <image class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" wx:if="{{userInfo.avatar}}"></image>
        <icon wx:else name="user" size="{{64}}" color="#FFFFFF" />
      </view>
      <view class="user-detail">
        <view class="user-name">{{userInfo.nickname || '点击登录'}}</view>
        <view class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
      </view>
    </view>
    <view class="setting-btn" bindtap="goToSetting">
      <icon name="setting" size="{{40}}" color="#FFFFFF" />
    </view>
  </view>

  <view class="stats-card card">
    <view class="stats-grid">
      <view class="stats-item" bindtap="goToOrderList" data-status="pending">
        <view class="icon-tile-sm tile-orange"><icon name="clock" size="{{36}}" color="#F59E0B" /></view>
        <view class="stats-num">{{orderStats.pending}}</view>
        <view class="stats-label">待支付</view>
      </view>
      <view class="stats-item" bindtap="goToOrderList" data-status="processing">
        <view class="icon-tile-sm tile-blue"><icon name="refresh" size="{{36}}" color="#3B82F6" /></view>
        <view class="stats-num">{{orderStats.processing}}</view>
        <view class="stats-label">处理中</view>
      </view>
      <view class="stats-item" bindtap="goToOrderList" data-status="completed">
        <view class="icon-tile-sm tile-green"><icon name="check-circle" size="{{36}}" color="#10B981" /></view>
        <view class="stats-num">{{orderStats.completed}}</view>
        <view class="stats-label">已完成</view>
      </view>
      <view class="stats-item" bindtap="goToOrderList" data-status="all">
        <view class="icon-tile-sm tile-brand"><icon name="order" size="{{36}}" color="#4F46E5" /></view>
        <view class="stats-num">{{orderStats.all}}</view>
        <view class="stats-label">全部</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAddress">
        <view class="icon-tile-sm tile-orange"><icon name="location" size="{{36}}" color="#F59E0B" /></view>
        <text class="menu-text">地址管理</text>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
      <view class="menu-item" bindtap="goToCoupon">
        <view class="icon-tile-sm tile-red"><icon name="ticket" size="{{36}}" color="#EF4444" /></view>
        <text class="menu-text">我的优惠券</text>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
      <view class="menu-item" bindtap="goToHelp">
        <view class="icon-tile-sm tile-blue"><icon name="help" size="{{36}}" color="#3B82F6" /></view>
        <text class="menu-text">帮助中心</text>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="icon-tile-sm tile-green"><icon name="service" size="{{36}}" color="#10B981" /></view>
        <text class="menu-text">联系客服</text>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
    </view>
  </view>

  <view class="version-text">优印达 v1.0.0</view>
</view>
