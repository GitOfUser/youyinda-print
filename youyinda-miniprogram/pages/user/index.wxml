<view class="container">
  <view class="user-header">
    <view class="user-info">
      <view class="avatar avatar-lg">
        <image class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" wx:if="{{userInfo.avatar}}"></image>
        <text class="avatar-placeholder" wx:else>👤</text>
      </view>
      <view class="user-detail">
        <view class="user-name">{{userInfo.nickname || '点击登录'}}</view>
        <view class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
      </view>
      <view class="setting-btn" bindtap="goToSetting">⚙️</view>
    </view>
  </view>

  <view class="stats-card card">
    <view class="stats-grid">
      <view class="stats-item" bindtap="goToOrderList" data-status="pending">
        <view class="stats-num">{{orderStats.pending}}</view>
        <view class="stats-label">待支付</view>
      </view>
      <view class="stats-item" bindtap="goToOrderList" data-status="processing">
        <view class="stats-num">{{orderStats.processing}}</view>
        <view class="stats-label">处理中</view>
      </view>
      <view class="stats-item" bindtap="goToOrderList" data-status="completed">
        <view class="stats-num">{{orderStats.completed}}</view>
        <view class="stats-label">已完成</view>
      </view>
      <view class="stats-item" bindtap="goToCoupon">
        <view class="stats-num">{{orderStats.coupon}}</view>
        <view class="stats-label">优惠券</view>
      </view>
    </view>
  </view>

  <view class="card order-card">
    <view class="card-header" bindtap="goToOrderList">
      <view class="card-title">我的订单</view>
      <view class="view-all">
        <text>全部订单</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="order-tabs">
      <view class="order-tab" bindtap="goToOrderList" data-status="pending">
        <view class="order-tab-icon">💰</view>
        <text class="order-tab-text">待支付</text>
      </view>
      <view class="order-tab" bindtap="goToOrderList" data-status="processing">
        <view class="order-tab-icon">📦</view>
        <text class="order-tab-text">处理中</text>
      </view>
      <view class="order-tab" bindtap="goToOrderList" data-status="completed">
        <view class="order-tab-icon">✅</view>
        <text class="order-tab-text">已完成</text>
      </view>
      <view class="order-tab" bindtap="goToTrack">
        <view class="order-tab-icon">🚚</view>
        <text class="order-tab-text">物流跟踪</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAddress">
        <view class="menu-icon-wrap orange-bg">
          <text class="menu-icon">📍</text>
        </view>
        <text class="menu-text">地址管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToCoupon">
        <view class="menu-icon-wrap red-bg">
          <text class="menu-icon">🎫</text>
        </view>
        <text class="menu-text">我的优惠券</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-icon-wrap blue-bg">
          <text class="menu-icon">❓</text>
        </view>
        <text class="menu-text">帮助中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="menu-icon-wrap green-bg">
          <text class="menu-icon">💬</text>
        </view>
        <text class="menu-text">联系客服</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-icon-wrap gray-bg">
          <text class="menu-icon">ℹ️</text>
        </view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
