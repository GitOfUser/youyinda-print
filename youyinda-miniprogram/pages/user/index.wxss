.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: var(--s-xl);
}

.user-header {
  background: var(--brand-gradient);
  padding: 80rpx var(--page-margin) var(--s-xl);
  padding-top: calc(80rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-lg);
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-lg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--s-lg);
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, 0.85);
}

.setting-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stats-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 1;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: var(--s-lg) 0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-xs);
}

.stats-num {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--t1);
}

.stats-label {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.menu-list {
  padding: var(--s-sm) 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--s-md) 0;
}

.menu-text {
  flex: 1;
  margin-left: var(--s-md);
  font-size: var(--fs-base);
  color: var(--t1);
}

.version-text {
  text-align: center;
  font-size: var(--fs-xs);
  color: var(--t3);
  margin-top: var(--s-xl);
}
