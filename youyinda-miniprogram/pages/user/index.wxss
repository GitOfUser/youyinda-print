.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: var(--spacing-xl);
}

.user-header {
  background: var(--primary-gradient);
  padding: 80rpx var(--page-margin) var(--spacing-xl);
  padding-top: calc(80rpx + env(safe-area-inset-top));
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: var(--spacing-lg);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-lg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-lg);
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 64rpx;
  color: white;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: var(--fs-sm);
  color: rgba(255,255,255,0.85);
}

.setting-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.stats-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 1;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: var(--spacing-lg) 0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--text-title);
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.order-card {
  margin-top: var(--spacing-md);
}

.view-all {
  display: flex;
  align-items: center;
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.view-all .arrow {
  font-size: var(--fs-lg);
  margin-left: 4rpx;
}

.order-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding-top: var(--spacing-md);
}

.order-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-tab-icon {
  width: 88rpx;
  height: 88rpx;
  background: var(--primary-light);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: var(--spacing-sm);
}

.order-tab-text {
  font-size: var(--fs-xs);
  color: var(--text-body);
}

.menu-list {
  padding: var(--spacing-sm) 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
}

.menu-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.orange-bg {
  background: var(--primary-light);
}

.red-bg {
  background: var(--danger-light);
}

.blue-bg {
  background: var(--print-primary-light);
}

.green-bg {
  background: var(--success-light);
}

.gray-bg {
  background: var(--bg-gray);
}

.menu-icon {
  font-size: 36rpx;
}

.menu-text {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-title);
}

.menu-arrow {
  font-size: var(--fs-lg);
  color: var(--text-hint);
  flex-shrink: 0;
}
