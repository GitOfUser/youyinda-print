.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-top: var(--spacing-md);
}

.address-card {
  margin-bottom: var(--spacing-md);
}

.address-content {
  display: flex;
  align-items: flex-start;
}

.address-icon {
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.address-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
  margin-right: var(--spacing-md);
}

.address-phone {
  font-size: var(--fs-base);
  color: var(--text-body);
}

.address-detail {
  font-size: var(--fs-sm);
  color: var(--text-body);
  line-height: 1.5;
}

.address-arrow {
  font-size: 40rpx;
  color: var(--text-hint);
  margin-left: var(--spacing-sm);
  flex-shrink: 0;
  line-height: 1;
}

.address-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
}

.empty-icon {
  font-size: 48rpx;
  margin-right: var(--spacing-md);
  opacity: 0.6;
}

.empty-text {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-secondary);
}

.order-card {
  margin-bottom: var(--spacing-md);
}

.edit-btn {
  font-size: var(--fs-sm);
  padding: 0;
}

.section-subtitle {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}

.file-list-section {
  margin-bottom: var(--spacing-lg);
}

.file-item-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.file-item-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm);
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
}

.file-icon-sm {
  font-size: 32rpx;
  margin-right: var(--spacing-sm);
}

.file-name-sm {
  flex: 1;
  font-size: var(--fs-sm);
  color: var(--text-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.config-tags-section {
  margin-bottom: 0;
}

.config-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.config-tag {
  font-size: var(--fs-xs);
}

.coupon-card {
  margin-bottom: var(--spacing-md);
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-left {
  display: flex;
  align-items: center;
}

.coupon-icon {
  font-size: 40rpx;
  margin-right: var(--spacing-sm);
}

.coupon-label {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
}

.coupon-right {
  display: flex;
  align-items: center;
}

.coupon-value {
  font-size: var(--fs-base);
  color: var(--danger);
  font-weight: 600;
  margin-right: var(--spacing-xs);
}

.coupon-placeholder {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-right: var(--spacing-xs);
}

.coupon-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
}

.remark-card {
  margin-bottom: var(--spacing-md);
}

.remark-input {
  width: 100%;
  min-height: 160rpx;
  padding: var(--spacing-md);
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--fs-sm);
  color: var(--text-title);
  box-sizing: border-box;
  line-height: 1.6;
}

.price-card {
  margin-bottom: var(--spacing-md);
}

.price-details {
  margin-bottom: var(--spacing-md);
}

.price-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-xs) 0;
}

.price-item-label {
  font-size: var(--fs-sm);
  color: var(--text-body);
}

.price-item-value {
  font-size: var(--fs-sm);
  color: var(--text-title);
}

.price-item-value.free {
  color: var(--success);
}

.price-item-value.discount {
  color: var(--danger);
}

.price-total-line {
  height: 1rpx;
  background: var(--divider);
  margin: var(--spacing-sm) 0;
}

.final-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-sm);
}

.final-label {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 600;
}

.final-price-wrap {
  display: flex;
  align-items: baseline;
}

.final-symbol {
  font-size: var(--fs-base);
  color: var(--print-primary);
  font-weight: 600;
}

.final-price {
  font-size: var(--fs-xxl);
  color: var(--print-primary);
  font-weight: 700;
}

.agreement-section {
  margin-bottom: var(--spacing-xl);
}

.agreement-check {
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-sm);
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: var(--print-primary);
  border-color: var(--print-primary);
}

.check-icon {
  font-size: 24rpx;
  color: white;
  font-weight: bold;
}

.agreement-text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.agreement-link {
  font-size: var(--fs-sm);
  color: var(--print-primary);
}

.total-label-sm {
  font-size: var(--fs-sm);
  color: var(--text-body);
  margin-bottom: 4rpx;
}

.total-price-sm {
  display: flex;
  align-items: baseline;
}

.total-symbol {
  font-size: var(--fs-base);
  color: var(--print-primary);
  font-weight: 600;
}

.total-number {
  font-size: var(--fs-xxl);
  color: var(--print-primary);
  font-weight: 700;
}

.btn-pay {
  min-width: 280rpx;
}
