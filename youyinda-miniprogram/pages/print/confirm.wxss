.container {
  min-height: 100vh;
  padding-top: var(--s-md);
}

/* 收货地址卡片 */
.address-card {
  display: flex;
  align-items: flex-start;
  position: relative;
}
.addr-ico {
  margin-right: var(--s-md);
  flex-shrink: 0;
}
.addr-info {
  flex: 1;
  min-width: 0;
}
.addr-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.addr-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
  margin-right: var(--s-md);
}
.addr-phone {
  font-size: var(--fs-base);
  color: var(--t2);
}
.addr-detail {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.5;
}
.addr-empty {
  display: flex;
  align-items: center;
  flex: 1;
}
.addr-empty-text {
  font-size: var(--fs-base);
  color: var(--t3);
}
.addr-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.edit-link {
  font-size: var(--fs-sm);
  color: var(--print);
  font-weight: 500;
}

/* 订单文件清单 */
.file-item-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-sm);
}
.file-item-row {
  display: flex;
  align-items: flex-start;
  padding: var(--s-sm);
  background: var(--fill);
  border-radius: var(--r-sm);
}
.row-ico {
  flex-shrink: 0;
  margin-right: var(--s-sm);
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-name {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--t1);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.row-price {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--print);
}

/* 优惠券 */
.coupon-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.coupon-left {
  display: flex;
  align-items: center;
}
.coupon-ico {
  margin-right: var(--s-sm);
  flex-shrink: 0;
}
.coupon-label {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--t1);
}
.coupon-right {
  display: flex;
  align-items: center;
}
.coupon-value {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--danger);
  margin-right: var(--s-xs);
}
.coupon-placeholder {
  font-size: var(--fs-sm);
  color: var(--t3);
  margin-right: var(--s-xs);
}

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 160rpx;
  padding: var(--s-md);
  background: var(--fill);
  border-radius: var(--r-md);
  font-size: var(--fs-sm);
  color: var(--t1);
  box-sizing: border-box;
  line-height: 1.6;
}

/* 费用明细 */
.price-details {
  margin-bottom: var(--s-md);
}
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-xs) 0;
}
.price-label {
  font-size: var(--fs-sm);
  color: var(--t2);
}
.price-value {
  font-size: var(--fs-sm);
  color: var(--t1);
  font-weight: 500;
}
.price-value.free {
  color: var(--success);
}
.price-value.discount {
  color: var(--danger);
}
.price-divider {
  height: 1rpx;
  background: var(--line);
  margin: var(--s-sm) 0;
}
.final-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--s-sm);
}
.final-label {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
}
.final-price-wrap {
  display: flex;
  align-items: baseline;
}
.final-symbol {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--print);
}
.final-price {
  font-size: var(--fs-xxl);
  font-weight: 700;
  color: var(--print);
}

/* 协议 */
.agreement {
  margin-bottom: var(--s-xl);
}
.agreement-check {
  display: flex;
  align-items: center;
}
.agreement-text {
  font-size: var(--fs-sm);
  color: var(--t2);
  margin-left: var(--s-sm);
}
.agreement-link {
  font-size: var(--fs-sm);
  color: var(--print);
  margin-left: 4rpx;
}

/* 圆形复选框 */
.check-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.check-circle.on {
  background: var(--print-gradient);
  border-color: transparent;
}
