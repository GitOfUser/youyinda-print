/* 打印购物车页 - 结构性样式（颜色/字号引用 CSS 变量） */
.container {
  min-height: 100vh;
  padding-top: var(--s-md);
}

/* 空状态按钮 */
.empty-upload-btn {
  margin-top: var(--s-lg);
}

/* 工具栏 */
.cart-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-md) 0;
}
.select-all {
  display: flex;
  align-items: center;
}
.toolbar-text {
  font-size: var(--fs-sm);
  color: var(--t2);
  margin-left: var(--s-xs);
}
.toolbar-actions {
  display: flex;
  align-items: center;
  gap: var(--s-lg);
}
.toolbar-btn {
  font-size: var(--fs-sm);
  color: var(--print);
  font-weight: 500;
}
.toolbar-btn.danger {
  color: var(--danger);
}

/* 圆形复选框（选中=品牌渐变底白 check 图标） */
.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.check-circle.on {
  background: var(--print-gradient);
  border-color: transparent;
}

/* 列表 */
.cart-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-md);
}
.cart-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
}
.cart-check {
  margin-right: var(--s-sm);
  padding-top: 4rpx;
}
.cart-ico {
  margin-right: var(--s-md);
  flex-shrink: 0;
}
.cart-main {
  flex: 1;
  min-width: 0;
  margin-right: var(--s-md);
}
.cart-name {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-size {
  font-size: var(--fs-xs);
  color: var(--t3);
  margin-bottom: 12rpx;
}
.cart-summary {
  margin-bottom: 12rpx;
}
.cart-price {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--print);
}
.cart-ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--s-sm);
  flex-shrink: 0;
}
.txt-btn {
  font-size: var(--fs-sm);
  color: var(--print);
  font-weight: 500;
}
.txt-btn.danger {
  color: var(--t3);
}
