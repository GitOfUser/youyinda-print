.container {
  min-height: 100vh;
  padding-top: var(--s-md);
}

/* 上传须知 */
.tip-card {
  display: flex;
  align-items: flex-start;
}
.tip-ico {
  margin-right: var(--s-md);
  flex-shrink: 0;
}
.tip-title {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}
.tip-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.5;
}

/* 大虚线边框上传区 */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx var(--s-lg);
  border: 3rpx dashed var(--print);
  background: var(--print-light);
  transition: transform 0.2s ease;
}
.upload-area:active {
  transform: scale(0.99);
}
.upload-tile {
  margin-bottom: var(--s-md);
}
.upload-main {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--print);
  margin-bottom: 8rpx;
}
.upload-sub {
  font-size: var(--fs-sm);
  color: var(--t2);
}

/* 上传中提示 */
.uploading-bar {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
  margin-top: var(--s-md);
}
.uploading-text {
  font-size: var(--fs-sm);
  color: var(--print);
}

/* 文件列表 */
.file-section {
  margin-top: var(--s-md);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-md);
}
.count-badge {
  padding: 6rpx 20rpx;
  background: var(--print-light);
  color: var(--print);
  font-size: var(--fs-xs);
  font-weight: 600;
  border-radius: var(--r-full);
}

.file-list {
  display: flex;
  flex-direction: column;
}
.file-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 0 var(--page-margin) var(--s-sm);
}
.file-ico {
  margin-right: var(--s-md);
  flex-shrink: 0;
}
.file-main {
  flex: 1;
  min-width: 0;
  margin-right: var(--s-md);
}
.file-name {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.file-meta {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}
.file-size {
  font-size: var(--fs-xs);
  color: var(--t3);
}
.file-stat {
  font-size: var(--fs-xs);
  font-weight: 500;
}
.file-stat.up { color: var(--print); }
.file-stat.ok { color: var(--success); }
.file-stat.err { color: var(--danger); }

.progress {
  margin-top: 12rpx;
  height: 8rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: var(--print-gradient);
  border-radius: var(--r-full);
  transition: width 0.3s ease;
}
.progress-bar.done {
  background: var(--success);
}

.file-ops {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
  flex-shrink: 0;
}
.retry-btn {
  font-size: var(--fs-sm);
  color: var(--print);
  font-weight: 500;
  padding: 8rpx 16rpx;
}
.del-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--fill);
}
.del-btn:active {
  background: var(--border);
}

/* 底部栏左侧信息 */
.bb-label {
  font-size: var(--fs-sm);
  color: var(--t2);
}
.bb-unit {
  font-size: var(--fs-sm);
  color: var(--t2);
  margin-left: 8rpx;
}
