.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-top: var(--spacing-md);
}

.upload-tips {
  margin-bottom: var(--spacing-md);
}

.tips-header {
  display: flex;
  align-items: flex-start;
}

.tips-icon {
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: 8rpx;
}

.tips-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

.upload-area {
  border: 3rpx dashed var(--print-primary);
  background: var(--print-primary-light);
  padding: 0;
  margin-bottom: var(--spacing-lg);
  transition: all 0.2s ease;
}

.upload-area:active {
  transform: scale(0.99);
  background: #DCE6FF;
}

.upload-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx var(--spacing-lg);
}

.upload-cloud-icon {
  font-size: 96rpx;
  margin-bottom: var(--spacing-lg);
}

.upload-main-text {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--print-primary);
  margin-bottom: var(--spacing-sm);
}

.upload-sub-text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 48rpx;
  background: var(--print-gradient);
  border-radius: var(--radius-full);
  box-shadow: var(--print-shadow);
}

.upload-btn-text {
  color: white;
  font-size: var(--fs-base);
  font-weight: 600;
}

.file-section {
  margin-top: var(--spacing-md);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
}

.file-count-badge {
  padding: 6rpx 20rpx;
  background: var(--print-primary-light);
  color: var(--print-primary);
  font-size: var(--fs-xs);
  font-weight: 600;
  border-radius: var(--radius-full);
}

.file-list {
  display: flex;
  flex-direction: column;
}

.file-item {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.file-item:last-child {
  margin-bottom: 0;
}

.file-type-icon {
  margin-right: var(--spacing-md);
  flex-shrink: 0;
  font-size: 36rpx;
}

.file-info {
  flex: 1;
  min-width: 0;
  margin-right: var(--spacing-md);
}

.file-name {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.file-size {
  font-size: var(--fs-xs);
  color: var(--text-secondary);
}

.file-status {
  font-size: var(--fs-xs);
  color: var(--print-primary);
}

.file-status.success {
  color: var(--success);
}

.file-status.error {
  color: var(--danger);
}

.file-progress {
  margin-top: 12rpx;
  height: 8rpx;
  background: var(--bg-gray);
  border-radius: 4rpx;
  overflow: hidden;
}

.file-progress-bar {
  height: 100%;
  background: var(--print-gradient);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.file-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex-shrink: 0;
}

.file-retry {
  font-size: var(--fs-sm);
  color: var(--print-primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
}

.file-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-gray);
}

.delete-icon {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.file-delete:active .delete-icon {
  color: var(--danger);
}

.file-count-text {
  font-size: var(--fs-sm);
  color: var(--text-body);
}

.count-num {
  color: var(--print-primary);
  font-weight: 700;
  font-size: var(--fs-lg);
  margin: 0 4rpx;
}

.btn-next {
  min-width: 240rpx;
}
