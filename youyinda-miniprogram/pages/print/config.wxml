<view class="container">
  <view class="file-preview card" wx:if="{{fileList.length > 0}}">
    <view class="preview-header">
      <view class="preview-icon icon-box icon-box-print">📁</view>
      <view class="preview-info">
        <view class="preview-title">已选文件</view>
        <view class="preview-count">共 {{fileList.length}} 个文件</view>
      </view>
    </view>
    <scroll-view class="file-scroll" scroll-x="true">
      <view class="file-mini-list">
        <view class="file-mini-item" wx:for="{{fileList}}" wx:key="index">
          <view class="file-mini-icon">📄</view>
          <view class="file-mini-name">{{item.name}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="config-card card">
    <view class="card-header">
      <view class="card-title">📐 纸张规格</view>
    </view>
    <view class="option-group">
      <view class="option-item {{paperSize === 'A4' ? 'print-active' : ''}}" bindtap="selectPaper" data-size="A4">
        <view class="option-name">A4</view>
        <view class="option-desc">210×297mm</view>
      </view>
      <view class="option-item {{paperSize === 'A3' ? 'print-active' : ''}}" bindtap="selectPaper" data-size="A3">
        <view class="option-name">A3</view>
        <view class="option-desc">297×420mm</view>
      </view>
      <view class="option-item {{paperSize === 'B5' ? 'print-active' : ''}}" bindtap="selectPaper" data-size="B5">
        <view class="option-name">B5</view>
        <view class="option-desc">176×250mm</view>
      </view>
    </view>
  </view>

  <view class="config-card card">
    <view class="card-header">
      <view class="card-title">🎨 色彩模式</view>
    </view>
    <view class="option-group">
      <view class="option-item {{colorType === 1 ? 'print-active' : ''}}" bindtap="selectColor" data-type="1">
        <view class="option-name">黑白</view>
        <view class="option-desc">经济实惠</view>
      </view>
      <view class="option-item {{colorType === 2 ? 'print-active' : ''}}" bindtap="selectColor" data-type="2">
        <view class="option-name">彩色</view>
        <view class="option-desc">色彩鲜艳</view>
      </view>
    </view>
  </view>

  <view class="config-card card">
    <view class="card-header">
      <view class="card-title">📄 单双面</view>
    </view>
    <view class="option-group">
      <view class="option-item {{duplex === 1 ? 'print-active' : ''}}" bindtap="selectDuplex" data-type="1">
        <view class="option-name">单面打印</view>
        <view class="option-desc">适合正式文件</view>
      </view>
      <view class="option-item {{duplex === 2 ? 'print-active' : ''}}" bindtap="selectDuplex" data-type="2">
        <view class="option-name">双面打印</view>
        <view class="option-desc">环保省纸</view>
      </view>
    </view>
  </view>

  <view class="config-card card">
    <view class="card-header">
      <view class="card-title">🔢 打印份数</view>
    </view>
    <view class="quantity-row">
      <view class="quantity-label">份数</view>
      <view class="quantity-control">
        <view class="quantity-btn" bindtap="decreaseQuantity">
          <text>−</text>
        </view>
        <view class="quantity-value">{{copies}}</view>
        <view class="quantity-btn" bindtap="increaseQuantity">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="config-card card">
    <view class="card-header">
      <view class="card-title">📎 装订方式</view>
    </view>
    <view class="binding-grid">
      <view class="binding-item {{binding === 'none' ? 'print-active' : ''}}" bindtap="selectBinding" data-type="none">
        <view class="binding-icon-box">📃</view>
        <view class="binding-name">无装订</view>
        <view class="binding-price free">免费</view>
      </view>
      <view class="binding-item {{binding === 'staple' ? 'print-active' : ''}}" bindtap="selectBinding" data-type="staple">
        <view class="binding-icon-box">📎</view>
        <view class="binding-name">订书钉</view>
        <view class="binding-price">¥1.00</view>
      </view>
      <view class="binding-item {{binding === 'clip' ? 'print-active' : ''}}" bindtap="selectBinding" data-type="clip">
        <view class="binding-icon-box">🗂️</view>
        <view class="binding-name">长尾夹</view>
        <view class="binding-price">¥0.50</view>
      </view>
      <view class="binding-item {{binding === 'glue' ? 'print-active' : ''}}" bindtap="selectBinding" data-type="glue">
        <view class="binding-icon-box">📘</view>
        <view class="binding-name">胶装</view>
        <view class="binding-price">¥5.00</view>
      </view>
      <view class="binding-item {{binding === 'ring' ? 'print-active' : ''}}" bindtap="selectBinding" data-type="ring">
        <view class="binding-icon-box">📒</view>
        <view class="binding-name">圈装</view>
        <view class="binding-price">¥8.00</view>
      </view>
      <view class="binding-item {{binding === 'cover' ? 'print-active' : ''}}" bindtap="selectBinding" data-type="cover">
        <view class="binding-icon-box">📕</view>
        <view class="binding-name">封皮</view>
        <view class="binding-price">¥3.00</view>
      </view>
    </view>
  </view>

  <view class="price-card card">
    <view class="card-header">
      <view class="card-title">💰 价格明细</view>
    </view>
    <view class="price-list">
      <view class="price-row">
        <text class="price-label">打印费用</text>
        <text class="price-value">¥{{basePrice}}</text>
      </view>
      <view class="price-row" wx:if="{{colorType === 2}}">
        <text class="price-label">彩色附加费</text>
        <text class="price-value">¥{{colorPrice}}</text>
      </view>
      <view class="price-row" wx:if="{{binding !== 'none'}}">
        <text class="price-label">装订费用</text>
        <text class="price-value">¥{{bindingPrice}}</text>
      </view>
      <view class="price-row" wx:if="{{copies > 1}}">
        <text class="price-label">×{{copies}}份</text>
        <text class="price-value"></text>
      </view>
    </view>
    <view class="price-divider"></view>
    <view class="price-total-row">
      <text class="total-label">预计总价</text>
      <text class="total-value">¥{{totalPrice}}</text>
    </view>
  </view>

  <view class="bottom-bar-placeholder"></view>

  <view class="bottom-bar">
    <view class="bottom-bar-left">
      <view class="bottom-bar-label">预计费用</view>
      <view class="bottom-bar-price">
        <text class="price-symbol">¥</text>
        <text class="price-number">{{totalPrice}}</text>
      </view>
    </view>
    <button class="btn-primary btn-print btn-confirm" bindtap="goToConfirm">
      确认配置
    </button>
  </view>
</view>
