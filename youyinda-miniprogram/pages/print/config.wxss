.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-top: var(--spacing-md);
}

.file-preview {
  margin-bottom: var(--spacing-md);
}

.preview-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.preview-icon {
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.preview-info {
  flex: 1;
}

.preview-title {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: 4rpx;
}

.preview-count {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.file-scroll {
  width: 100%;
  white-space: nowrap;
}

.file-mini-list {
  display: inline-flex;
  gap: var(--spacing-sm);
  padding-bottom: var(--spacing-xs);
}

.file-mini-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md);
  background: var(--print-primary-light);
  border-radius: var(--radius-md);
  min-width: 140rpx;
}

.file-mini-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.file-mini-name {
  font-size: var(--fs-xs);
  color: var(--print-primary);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.config-card {
  margin-bottom: var(--spacing-md);
}

.option-group {
  display: flex;
  gap: var(--spacing-sm);
}

.option-item {
  flex: 1;
  min-width: 0;
  padding: var(--spacing-md) var(--spacing-sm);
  text-align: center;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  background: var(--white);
  transition: all 0.2s ease;
}

.option-item.print-active {
  border-color: var(--print-primary);
  background: var(--print-primary-light);
}

.option-item:active {
  transform: scale(0.98);
}

.option-name {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--text-title);
  margin-bottom: 4rpx;
}

.option-item.print-active .option-name {
  color: var(--print-primary);
  font-weight: 600;
}

.option-desc {
  font-size: var(--fs-xs);
  color: var(--text-secondary);
}

.option-item.print-active .option-desc {
  color: var(--print-primary);
  opacity: 0.8;
}

.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  background: var(--bg-gray);
  border-radius: var(--radius-full);
}

.quantity-label {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--white);
  border-radius: 50%;
  font-size: var(--fs-xl);
  color: var(--print-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.quantity-btn:active {
  background: var(--print-primary-light);
}

.quantity-value {
  font-size: var(--fs-xl);
  color: var(--text-title);
  font-weight: 700;
  min-width: 80rpx;
  text-align: center;
}

.binding-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-sm);
}

.binding-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-sm);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  background: var(--white);
  transition: all 0.2s ease;
}

.binding-item.print-active {
  border-color: var(--print-primary);
  background: var(--print-primary-light);
}

.binding-item:active {
  transform: scale(0.98);
}

.binding-icon-box {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  margin-bottom: var(--spacing-sm);
}

.binding-item.print-active .binding-icon-box {
  background: var(--white);
}

.binding-name {
  font-size: var(--fs-sm);
  color: var(--text-title);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.binding-item.print-active .binding-name {
  color: var(--print-primary);
  font-weight: 600;
}

.binding-price {
  font-size: var(--fs-xs);
  color: var(--print-primary);
  font-weight: 600;
}

.binding-price.free {
  color: var(--success);
}

.price-list {
  margin-bottom: var(--spacing-md);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.price-label {
  font-size: var(--fs-sm);
  color: var(--text-body);
}

.price-value {
  font-size: var(--fs-sm);
  color: var(--text-title);
  font-weight: 500;
}

.price-divider {
  height: 1rpx;
  background: var(--divider);
  margin: var(--spacing-sm) 0;
}

.price-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-sm);
}

.total-label {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 600;
}

.total-value {
  font-size: var(--fs-xxl);
  color: var(--print-primary);
  font-weight: 700;
}

.bottom-bar-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: var(--fs-base);
  color: var(--print-primary);
  font-weight: 600;
}

.price-number {
  font-size: var(--fs-xxl);
  color: var(--print-primary);
  font-weight: 700;
}

.btn-confirm {
  min-width: 240rpx;
}
