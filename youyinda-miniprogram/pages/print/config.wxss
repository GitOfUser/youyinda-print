.container {
  min-height: 100vh;
  padding-top: var(--s-md);
}

/* 文件信息条 */
.file-bar {
  display: flex;
  align-items: center;
}
.file-bar-ico {
  margin-right: var(--s-md);
  flex-shrink: 0;
}
.file-bar-title {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 4rpx;
}
.file-bar-count {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.card-header {
  margin-bottom: var(--s-md);
}

/* 选项组内文字（复用全局 .opt / .opt.active） */
.opt-name {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--t1);
}
.opt.active .opt-name {
  color: var(--print);
  font-weight: 600;
}
.opt-desc {
  font-size: var(--fs-xs);
  color: var(--t2);
  margin-top: 4rpx;
}
.opt.active .opt-desc {
  color: var(--print);
  opacity: 0.85;
}

/* 装订方式网格 */
.binding-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-sm);
}
.binding-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: var(--s-md) var(--s-xs);
}
.opt-price {
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--print);
}
.opt-price.free {
  color: var(--success);
}

/* 份数 - 复用全局 .quantity-control / .quantity-btn / .quantity-value */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-md);
  background: var(--fill);
  border-radius: var(--r-full);
}
.quantity-label {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--t1);
}

/* 价格明细 */
.price-list {
  margin-bottom: var(--s-md);
}
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-xs) 0;
}
.price-label {
  font-size: var(--fs-sm);
  color: var(--t2);
}
.price-value {
  font-size: var(--fs-sm);
  color: var(--t1);
  font-weight: 500;
}
.price-divider {
  height: 1rpx;
  background: var(--line);
  margin: var(--s-sm) 0;
}
.price-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--s-sm);
}
.total-label {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
}
.total-price-wrap {
  display: flex;
  align-items: baseline;
}
.total-symbol {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--print);
}
.total-value {
  font-size: var(--fs-xxl);
  font-weight: 700;
  color: var(--print);
}
