/* 登录页：仅结构性样式，颜色/字号/圆角一律引用 app.wxss 变量 */

.login-container {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.login-top-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 480rpx;
  background: var(--brand-gradient);
  border-radius: 0 0 60rpx 60rpx;
  opacity: 0.08;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  padding-bottom: 64rpx;
  position: relative;
  z-index: 1;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: var(--brand-gradient);
  box-shadow: var(--brand-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--s-lg);
}

.login-app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--t1);
  margin-bottom: var(--s-xs);
  letter-spacing: 4rpx;
}

.login-app-desc {
  font-size: var(--fs-sm);
  color: var(--t3);
  letter-spacing: 2rpx;
}

.login-features {
  display: flex;
  justify-content: space-around;
  padding: var(--s-lg) 0;
  position: relative;
  z-index: 1;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-text {
  margin-top: var(--s-sm);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--t2);
}

.login-footer {
  padding: var(--s-xl) var(--page-margin);
  padding-bottom: calc(var(--s-xl) + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

/* 表单 */
.login-form {
  margin-bottom: var(--s-lg);
}

.login-input-group {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--r-full);
  border: 2rpx solid var(--border);
  padding: 0 var(--s-lg);
  height: 96rpx;
  margin-bottom: var(--s-md);
  box-shadow: var(--shadow-card);
}

.login-input-group:focus-within {
  border-color: var(--brand);
}

.login-input-icon {
  margin-right: var(--s-sm);
  flex-shrink: 0;
}

.login-input {
  flex: 1;
  height: 96rpx;
  font-size: var(--fs-md);
  color: var(--t1);
}

.login-input-placeholder {
  color: var(--t3);
}

/* 主按钮直接使用全局 .btn-primary .btn-block */
.login-btn {
  margin-top: 0;
}

.login-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--s-lg);
}

.login-switch-text {
  font-size: var(--fs-sm);
  color: var(--t3);
}

.login-switch-link {
  font-size: var(--fs-sm);
  color: var(--brand);
  font-weight: 500;
  margin-left: var(--s-xs);
}

.login-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: var(--s-lg);
  line-height: 1.6;
}

.checkbox-wrapper {
  margin-right: var(--s-xs);
  padding: 8rpx;
}

.login-checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
}

.login-checkbox.checked {
  background: var(--brand-gradient);
  border-color: var(--brand);
}

.agreement-text {
  font-size: var(--fs-xs);
  color: var(--t3);
}

.agreement-link {
  font-size: var(--fs-xs);
  color: var(--brand);
}
