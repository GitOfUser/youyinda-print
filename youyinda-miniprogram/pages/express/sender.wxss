button::after {
  border: none;
}

.page-header {
  padding: var(--s-lg) var(--page-margin);
  padding-top: calc(var(--s-lg) + env(safe-area-inset-top));
  background: var(--express-gradient);
}

.header-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: var(--s-xs);
}

.header-desc {
  font-size: var(--fs-sm);
  color: var(--white);
  opacity: 0.85;
}

.address-section {
  margin-top: -24rpx;
  position: relative;
  z-index: 1;
}

.addr-card {
  position: relative;
}

.addr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-md);
}

.addr-head-left {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}

.addr-type {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.addr-top {
  display: flex;
  align-items: center;
  gap: var(--s-md);
  margin-bottom: var(--s-xs);
}

.addr-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.addr-phone {
  font-size: var(--fs-base);
  color: var(--t2);
}

.addr-loc {
  font-size: var(--fs-base);
  color: var(--t2);
  line-height: 1.6;
}

.addr-placeholder .ph-text {
  font-size: var(--fs-base);
  color: var(--t3);
}

.exchange-wrap {
  display: flex;
  justify-content: center;
  position: relative;
  z-index: 2;
  margin: -20rpx 0;
}

.exchange-btn {
  width: 72rpx;
  height: 72rpx;
  background: var(--card);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
  border: 4rpx solid var(--bg);
}

.exchange-btn:active {
  background: var(--fill);
}

.tips-head {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
  margin-bottom: var(--s-md);
}

.tips-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: var(--s-sm);
}

.tips-item {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.5;
}
