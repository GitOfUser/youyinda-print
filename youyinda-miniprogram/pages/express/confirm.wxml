<view class="container">
  <view class="page-header">
    <view class="header-title">确认订单</view>
    <view class="header-desc">请核对订单信息，确认无误后提交</view>
  </view>

  <!-- 路线 -->
  <view class="card route-card">
    <view class="route-row">
      <view class="icon-tile-sm tile-express">
        <icon name="location" size="{{40}}" color="#0D9488" />
      </view>
      <view class="route-body">
        <view class="route-label">寄件人</view>
        <view>
          <text class="route-name">{{senderAddress.name}}</text>
          <text class="route-phone">{{senderAddress.phone}}</text>
        </view>
        <view class="route-addr">{{senderAddress.province}}{{senderAddress.city}}{{senderAddress.district}}{{senderAddress.detail}}</view>
      </view>
    </view>
    <view class="route-divider"></view>
    <view class="route-row">
      <view class="icon-tile-sm tile-brand">
        <icon name="location" size="{{40}}" color="#4F46E5" />
      </view>
      <view class="route-body">
        <view class="route-label">收件人</view>
        <view>
          <text class="route-name">{{receiverAddress.name}}</text>
          <text class="route-phone">{{receiverAddress.phone}}</text>
        </view>
        <view class="route-addr">{{receiverAddress.province}}{{receiverAddress.city}}{{receiverAddress.district}}{{receiverAddress.detail}}</view>
      </view>
    </view>
  </view>

  <!-- 物品信息 -->
  <view class="card">
    <view class="info-row">
      <text class="info-label">物品类型</text>
      <text class="info-value">{{packageInfo.itemType}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">物品重量</text>
      <text class="info-value">{{packageInfo.weight}}kg</text>
    </view>
    <view class="info-row" wx:if="{{packageInfo.remark}}">
      <text class="info-label">物品描述</text>
      <text class="info-value">{{packageInfo.remark}}</text>
    </view>
  </view>

  <!-- 所选快递公司 -->
  <view class="card">
    <view class="co-row">
      <view class="co-avatar">
        <text class="co-avatar-text">{{selectedCompany.expressCode}}</text>
      </view>
      <view class="co-detail">
        <text class="co-name">{{selectedCompany.name}}</text>
        <text class="co-desc">{{selectedCompany.desc}}</text>
      </view>
      <text class="co-price">¥{{selectedCompany.price}}</text>
    </view>
  </view>

  <!-- 优惠券 -->
  <view class="card coupon-card" bindtap="selectCoupon">
    <view class="coupon-row">
      <view class="coupon-left">
        <view class="icon-tile-sm tile-orange">
          <icon name="coupon" size="{{36}}" color="#F59E0B" />
        </view>
        <text class="coupon-text">优惠券</text>
      </view>
      <view class="coupon-right">
        <text wx:if="{{coupon}}" class="coupon-val">-¥{{coupon.amount}}</text>
        <text wx:else class="coupon-sel">选择优惠券</text>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="card">
    <view class="price-title">费用明细</view>
    <view class="price-row">
      <text class="price-label">运费</text>
      <text class="price-value">¥{{finalPrice}}</text>
    </view>
    <view class="price-row" wx:if="{{coupon}}">
      <text class="price-label">优惠</text>
      <text class="price-value text-danger">-¥{{coupon.amount}}</text>
    </view>
    <view class="price-divider"></view>
    <view class="price-row total-row">
      <text class="total-label">实付金额</text>
      <view class="total-price-wrap">
        <text class="total-symbol">¥</text>
        <text class="total-price">{{finalPrice}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar-space"></view>
  <view class="bottom-bar">
    <view class="bottom-bar-left">
      <view class="bottom-bar-label">实付金额</view>
      <view class="bottom-bar-value">¥{{finalPrice}}</view>
    </view>
    <button class="btn-primary btn-express" bindtap="createOrder">
      去支付
    </button>
  </view>
</view>
