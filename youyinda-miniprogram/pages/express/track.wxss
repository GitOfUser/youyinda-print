.status-card {
  background: var(--express-gradient);
  border-radius: 0 0 var(--r-xl) var(--r-xl);
  padding: calc(var(--s-xl) + env(safe-area-inset-top)) var(--page-margin) var(--s-xl);
  margin-bottom: var(--s-md);
}

.status-top {
  display: flex;
  align-items: center;
  gap: var(--s-md);
}

.status-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--express-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-main {
  flex: 1;
  min-width: 0;
}

.status-text {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: var(--s-xs);
}

.status-sub {
  font-size: var(--fs-sm);
  color: var(--white);
  opacity: 0.85;
}

.status-meta {
  margin-top: var(--s-md);
  display: flex;
  flex-direction: column;
  gap: var(--s-xs);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}

.meta-label {
  font-size: var(--fs-xs);
  color: var(--white);
  opacity: 0.7;
}

.meta-value {
  font-size: var(--fs-sm);
  color: var(--white);
}

.copy-ic {
  margin-left: var(--s-xs);
  opacity: 0.85;
}

.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-lg);
}

.tl-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.tl-count {
  font-size: var(--fs-sm);
  color: var(--t3);
}

.timeline {
  position: relative;
}

.tl-item {
  display: flex;
  position: relative;
}

.tl-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--border);
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
}

.tl-item.current .tl-dot {
  width: 28rpx;
  height: 28rpx;
  background: var(--express);
  box-shadow: 0 0 0 8rpx var(--express-light);
  margin-top: 4rpx;
}

.tl-line {
  width: 4rpx;
  flex: 1;
  background: var(--line);
  margin: var(--s-xs) 0;
}

.tl-content {
  flex: 1;
  padding-bottom: var(--s-lg);
  padding-left: var(--s-md);
}

.tl-item:last-child .tl-content {
  padding-bottom: 0;
}

.tl-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-xs);
}

.tl-status {
  font-size: var(--fs-base);
  color: var(--t2);
}

.tl-item.current .tl-status {
  font-weight: 600;
  color: var(--t1);
}

.tl-time {
  font-size: var(--fs-sm);
  color: var(--t3);
  flex-shrink: 0;
}

.meta-copy {
  cursor: pointer;
}

.meta-copy:active {
  opacity: 0.7;
}

.tl-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
  line-height: 1.5;
  margin-bottom: 4rpx;
}

.tl-item.current .tl-desc {
  color: var(--t1);
}

.tl-loc {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--fs-xs);
  color: var(--t3);
}

.bottom-placeholder {
  height: calc(env(safe-area-inset-bottom) + var(--s-lg));
}
