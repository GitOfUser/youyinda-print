<view class="container">
  <!-- 状态卡 -->
  <view class="status-card">
    <view class="status-top">
      <view class="status-icon">
        <icon name="truck" size="{{52}}" color="#FFFFFF" />
      </view>
      <view class="status-main">
        <view class="status-text">{{orderStatusText}}</view>
        <view class="status-sub">{{companyName}}</view>
      </view>
    </view>
    <view class="status-meta">
      <view class="meta-row meta-copy" bindtap="copyTrackingNo">
        <text class="meta-label">运单号</text>
        <text class="meta-value">{{trackingNo}}</text>
        <icon name="copy" size="{{28}}" color="#FFFFFF" class="copy-ic" />
      </view>
      <view class="meta-row" wx:if="{{latestTime}}">
        <text class="meta-label">更新时间</text>
        <text class="meta-value">{{latestTime}}</text>
      </view>
    </view>
  </view>

  <!-- 物流轨迹 -->
  <view class="card timeline-card">
    <view class="tl-head">
      <text class="tl-title">物流轨迹</text>
      <text class="tl-count">共 {{trackList.length}} 条</text>
    </view>
    <view class="timeline">
      <view class="tl-item {{index === 0 ? 'current' : ''}}" wx:for="{{trackList}}" wx:key="index">
        <view class="tl-left">
          <view class="tl-dot"></view>
          <view class="tl-line" wx:if="{{index < trackList.length - 1}}"></view>
        </view>
        <view class="tl-content">
          <view class="tl-info">
            <text class="tl-status">{{item.status}}</text>
            <text class="tl-time">{{item.time}}</text>
          </view>
          <view class="tl-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
          <view class="tl-loc" wx:if="{{item.location}}">
            <icon name="location" size="{{24}}" color="#94A3B8" />
            <text>{{item.location}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-placeholder"></view>
</view>
