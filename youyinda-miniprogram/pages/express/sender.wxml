<view class="container">
  <view class="page-header">
    <view class="header-title">填写寄件信息</view>
    <view class="header-desc">请准确填写寄件人和收件人信息</view>
  </view>

  <view class="address-section">
    <!-- 寄件人 -->
    <view class="card addr-card" bindtap="selectSender">
      <view class="addr-head">
        <view class="addr-head-left">
          <view class="icon-tile-sm tile-express">
            <icon name="location" size="{{40}}" color="#0D9488" />
          </view>
          <text class="addr-type">寄件人</text>
        </view>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
      <view wx:if="{{senderAddress}}" class="addr-detail">
        <view class="addr-top">
          <text class="addr-name">{{senderAddress.name}}</text>
          <text class="addr-phone">{{senderAddress.phone}}</text>
        </view>
        <view class="addr-loc">{{senderAddress.province}}{{senderAddress.city}}{{senderAddress.district}}{{senderAddress.detail}}</view>
      </view>
      <view wx:else class="addr-placeholder">
        <text class="ph-text">请选择寄件地址</text>
      </view>
    </view>

    <view class="exchange-wrap">
      <view class="exchange-btn" bindtap="exchangeAddress">
        <icon name="refresh" size="{{32}}" color="#0D9488" />
      </view>
    </view>

    <!-- 收件人 -->
    <view class="card addr-card" bindtap="selectReceiver">
      <view class="addr-head">
        <view class="addr-head-left">
          <view class="icon-tile-sm tile-brand">
            <icon name="location" size="{{40}}" color="#4F46E5" />
          </view>
          <text class="addr-type">收件人</text>
        </view>
        <icon name="chevron-right" size="{{36}}" color="#94A3B8" />
      </view>
      <view wx:if="{{receiverAddress}}" class="addr-detail">
        <view class="addr-top">
          <text class="addr-name">{{receiverAddress.name}}</text>
          <text class="addr-phone">{{receiverAddress.phone}}</text>
        </view>
        <view class="addr-loc">{{receiverAddress.province}}{{receiverAddress.city}}{{receiverAddress.district}}{{receiverAddress.detail}}</view>
      </view>
      <view wx:else class="addr-placeholder">
        <text class="ph-text">请选择收件地址</text>
      </view>
    </view>
  </view>

  <view class="card tips-card">
    <view class="tips-head">
      <view class="icon-tile-sm tile-orange">
        <icon name="info" size="{{36}}" color="#F59E0B" />
      </view>
      <text class="tips-title">寄件须知</text>
    </view>
    <view class="tips-list">
      <view class="tips-item">请确保物品包装完好，易碎品请标注</view>
      <view class="tips-item">禁止邮寄违禁品、液体、粉末等物品</view>
      <view class="tips-item">快递员上门取件时间为 9:00-18:00</view>
    </view>
  </view>

  <view class="bottom-bar-space"></view>
  <view class="bottom-bar">
    <button class="btn-primary btn-block btn-express" bindtap="goToPackage" disabled="{{!(senderAddress && receiverAddress)}}">
      下一步
    </button>
  </view>
</view>
