<view class="container">
  <view class="page-header">
    <view class="header-title">填写寄件信息</view>
    <view class="header-desc">请准确填写寄件人和收件人信息</view>
  </view>

  <view class="address-section">
    <view class="address-card sender-card">
      <view class="address-bar sender-bar"></view>
      <view class="address-content" bindtap="selectSender">
        <view class="address-header">
          <view class="address-type sender-type">
            <text class="type-icon">📍</text>
            <text>寄件人</text>
          </view>
          <text class="address-arrow">></text>
        </view>
        <view wx:if="{{senderAddress}}" class="address-detail">
          <view class="address-top">
            <text class="address-name">{{senderAddress.name}}</text>
            <text class="address-phone">{{senderAddress.phone}}</text>
          </view>
          <view class="address-location">{{senderAddress.province}}{{senderAddress.city}}{{senderAddress.district}}{{senderAddress.detail}}</view>
        </view>
        <view wx:else class="address-placeholder">
          <text class="placeholder-text">请选择寄件地址</text>
        </view>
      </view>
    </view>

    <view class="exchange-wrap">
      <view class="exchange-btn" bindtap="exchangeAddress">
        <text class="exchange-icon">⇅</text>
      </view>
    </view>

    <view class="address-card receiver-card">
      <view class="address-bar receiver-bar"></view>
      <view class="address-content" bindtap="selectReceiver">
        <view class="address-header">
          <view class="address-type receiver-type">
            <text class="type-icon">🏠</text>
            <text>收件人</text>
          </view>
          <text class="address-arrow">></text>
        </view>
        <view wx:if="{{receiverAddress}}" class="address-detail">
          <view class="address-top">
            <text class="address-name">{{receiverAddress.name}}</text>
            <text class="address-phone">{{receiverAddress.phone}}</text>
          </view>
          <view class="address-location">{{receiverAddress.province}}{{receiverAddress.city}}{{receiverAddress.district}}{{receiverAddress.detail}}</view>
        </view>
        <view wx:else class="address-placeholder">
          <text class="placeholder-text">请选择收件地址</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tips-card card">
    <view class="tips-header">
      <text class="tips-icon">💡</text>
      <text class="tips-title">寄件须知</text>
    </view>
    <view class="tips-list">
      <view class="tips-item">• 请确保物品包装完好，易碎品请标注</view>
      <view class="tips-item">• 禁止邮寄违禁品、液体、粉末等物品</view>
      <view class="tips-item">• 快递员上门取件时间为9:00-18:00</view>
    </view>
  </view>

  <view class="bottom-bar-placeholder"></view>

  <view class="bottom-bar">
    <button class="btn-primary btn-block {{!(senderAddress && receiverAddress) ? 'btn-disabled' : ''}}" bindtap="goToPackage" disabled="{{!(senderAddress && receiverAddress)}}">
      下一步
    </button>
  </view>
</view>
