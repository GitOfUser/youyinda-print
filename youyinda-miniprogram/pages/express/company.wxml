<view class="container">
  <view class="page-header">
    <view class="header-title">选择快递公司</view>
    <view class="header-desc">对比价格和时效，选择最合适的快递</view>
  </view>

  <view class="card rs-card">
    <view class="rs-route">
      <view class="rs-point">
        <text class="rs-city">{{senderAddress.city || senderAddress.province || '—'}}</text>
        <text class="rs-tag">寄件</text>
      </view>
      <icon name="arrow-right" size="{{36}}" color="#0D9488" class="rs-arrow" />
      <view class="rs-point">
        <text class="rs-city">{{receiverAddress.city || receiverAddress.province || '—'}}</text>
        <text class="rs-tag">收件</text>
      </view>
      <view class="rs-goods">
        <icon name="package" size="{{24}}" color="#94A3B8" />
        <text class="rs-goods-text">{{packageInfo.itemType}} · {{packageInfo.weight}}kg</text>
      </view>
    </view>
  </view>

  <view class="company-list">
    <view class="company-card {{selectedCompany && selectedCompany.id === item.id ? 'selected' : ''}}" wx:for="{{companyList}}" wx:key="id" bindtap="selectCompany" data-item="{{item}}">
      <view wx:if="{{selectedCompany && selectedCompany.id === item.id}}" class="co-check">
        <icon name="check-circle" size="{{40}}" color="#0D9488" />
      </view>
      <view class="co-main">
        <view class="co-avatar">
          <text class="co-avatar-text">{{item.expressCode}}</text>
        </view>
        <view class="co-info">
          <view class="co-name">{{item.name}}</view>
          <view class="co-tags">
            <text class="tag tag-express">{{item.desc}}</text>
            <text class="tag tag-info">{{item.expressCode}}</text>
          </view>
        </view>
        <view class="co-price">
          <text class="price-cur">¥</text><text class="price-num">{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar-space"></view>
  <view class="bottom-bar">
    <view class="bottom-bar-left" wx:if="{{selectedCompany}}">
      <view class="bottom-bar-label">已选择 {{selectedCompany.name}}</view>
      <view class="bottom-bar-value">¥{{selectedCompany.price}}</view>
    </view>
    <view class="bottom-bar-left" wx:else>
      <view class="bottom-bar-label">请选择快递公司</view>
    </view>
    <button class="btn-primary btn-express" bindtap="goToConfirm" disabled="{{!selectedCompany}}">
      下一步
    </button>
  </view>
</view>
