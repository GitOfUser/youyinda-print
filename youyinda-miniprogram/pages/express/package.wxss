button::after {
  border: none;
}

.page-header {
  padding: var(--s-lg) var(--page-margin);
  padding-top: calc(var(--s-lg) + env(safe-area-inset-top));
  background: var(--express-gradient);
}

.header-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: var(--s-xs);
}

.header-desc {
  font-size: var(--fs-sm);
  color: var(--white);
  opacity: 0.85;
}

.card-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--s-md);
}

.card-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.req {
  color: var(--danger);
  font-size: var(--fs-md);
  margin-left: 4rpx;
}

.opt-tip {
  font-size: var(--fs-sm);
  color: var(--t3);
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-sm);
}

.type-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-xs);
  padding: var(--s-md) var(--s-sm);
}

.type-name {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.type-opt.active-express .type-name {
  color: var(--express);
  font-weight: 600;
}

.weight-row {
  display: flex;
  align-items: center;
  gap: var(--s-md);
  background: var(--fill);
  border-radius: var(--r-md);
  padding: 0 var(--s-lg);
}

.weight-input {
  flex: 1;
  height: 120rpx;
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--t1);
  text-align: center;
  background: transparent;
}

.weight-unit {
  font-size: var(--fs-base);
  color: var(--t2);
}

.weight-tip {
  font-size: var(--fs-sm);
  color: var(--t3);
  margin-top: var(--s-sm);
  text-align: center;
}

.desc-input {
  width: 100%;
  min-height: 160rpx;
  background: var(--fill);
  border-radius: var(--r-sm);
  padding: var(--s-md);
  font-size: var(--fs-base);
  color: var(--t1);
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: var(--fs-xs);
  color: var(--t3);
  margin-top: var(--s-xs);
}
