button::after {
  border: none;
}

.page-header {
  padding: var(--s-lg) var(--page-margin);
  padding-top: calc(var(--s-lg) + env(safe-area-inset-top));
  background: var(--express-gradient);
}

.header-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: var(--s-xs);
}

.header-desc {
  font-size: var(--fs-sm);
  color: var(--white);
  opacity: 0.85;
}

.route-card {
  margin-top: -24rpx;
  position: relative;
  z-index: 1;
}

.route-row {
  display: flex;
  align-items: flex-start;
  gap: var(--s-md);
  padding: var(--s-sm) 0;
}

.route-body {
  flex: 1;
  min-width: 0;
}

.route-label {
  font-size: var(--fs-sm);
  color: var(--t2);
  font-weight: 500;
  margin-bottom: var(--s-xs);
}

.route-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.route-phone {
  font-size: var(--fs-base);
  color: var(--t2);
  margin-left: var(--s-sm);
}

.route-addr {
  font-size: var(--fs-base);
  color: var(--t2);
  line-height: 1.6;
  margin-top: var(--s-xs);
}

.route-divider {
  height: 1rpx;
  background: var(--line);
  margin: var(--s-sm) 0 var(--s-sm) 88rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--s-md) 0;
  border-bottom: 1rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--fs-base);
  color: var(--t2);
  flex-shrink: 0;
}

.info-value {
  font-size: var(--fs-base);
  color: var(--t1);
  text-align: right;
  flex: 1;
  margin-left: var(--s-lg);
}

.co-row {
  display: flex;
  align-items: center;
  gap: var(--s-md);
}

.co-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--express-gradient);
  flex-shrink: 0;
}

.co-avatar-text {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--white);
}

.co-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.co-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.co-desc {
  font-size: var(--fs-sm);
  color: var(--t2);
}

.co-price {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--express);
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-left {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}

.coupon-text {
  font-size: var(--fs-base);
  color: var(--t1);
  font-weight: 500;
}

.coupon-right {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}

.coupon-val {
  font-size: var(--fs-base);
  color: var(--danger);
  font-weight: 600;
}

.coupon-sel {
  font-size: var(--fs-sm);
  color: var(--t3);
}

.price-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: var(--s-md);
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-sm) 0;
}

.price-label {
  font-size: var(--fs-base);
  color: var(--t2);
}

.price-value {
  font-size: var(--fs-base);
  color: var(--t1);
}

.price-divider {
  height: 1rpx;
  background: var(--line);
  margin: var(--s-md) 0;
}

.total-row {
  padding-top: var(--s-md);
}

.total-label {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--t1);
}

.total-price-wrap {
  display: flex;
  align-items: baseline;
}

.total-symbol {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--express);
}

.total-price {
  font-size: var(--fs-xxl);
  font-weight: 700;
  color: var(--express);
}
