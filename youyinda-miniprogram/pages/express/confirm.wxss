.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: 200rpx;
}

.page-header {
  padding: var(--spacing-lg) var(--page-margin);
  background: linear-gradient(135deg, #FF7D00 0%, #FF9A3C 100%);
  padding-top: calc(var(--spacing-lg) + env(safe-area-inset-top));
}

.header-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: var(--spacing-xs);
}

.header-desc {
  font-size: var(--fs-sm);
  color: rgba(255,255,255,0.85);
}

.card {
  background: var(--white);
  border-radius: var(--radius-lg);
  margin: var(--spacing-md) var(--page-margin);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.address-card {
  margin-top: -24rpx;
  position: relative;
  z-index: 1;
}

.address-section-row {
  padding: var(--spacing-sm) 0;
}

.address-col {
  padding-left: var(--spacing-md);
}

.address-label-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.label-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.sender-dot {
  background: var(--express-primary);
}

.receiver-dot {
  background: #3B82F6;
}

.address-label {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  font-weight: 500;
}

.address-name-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-xs);
}

.person-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
}

.person-phone {
  font-size: var(--fs-base);
  color: var(--text-body);
}

.address-text {
  font-size: var(--fs-base);
  color: var(--text-body);
  line-height: 1.6;
  padding-left: 28rpx;
}

.address-line {
  height: 1rpx;
  background: var(--divider);
  margin: var(--spacing-sm) 0 var(--spacing-sm) var(--spacing-md);
  position: relative;
}

.address-line::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--white);
  border: 2rpx solid var(--express-primary);
}

.address-line::after {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--white);
  border: 2rpx solid #3B82F6;
  margin-top: 40rpx;
}

.company-card {
  margin-top: var(--spacing-md);
}

.company-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.company-logo-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.logo-small-text {
  font-size: var(--fs-base);
  font-weight: 700;
  color: var(--white);
}

.company-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.company-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
}

.company-time {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.company-price {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--express-primary);
}

.info-card {
  padding: 0;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1rpx solid var(--divider);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--fs-base);
  color: var(--text-secondary);
  flex-shrink: 0;
}

.info-value {
  font-size: var(--fs-base);
  color: var(--text-title);
  text-align: right;
  flex: 1;
  margin-left: var(--spacing-lg);
}

.coupon-card {
  padding: var(--spacing-lg) 0;
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--spacing-lg);
}

.coupon-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.coupon-icon {
  font-size: var(--fs-lg);
}

.coupon-text {
  font-size: var(--fs-base);
  color: var(--text-title);
  font-weight: 500;
}

.coupon-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.coupon-discount {
  font-size: var(--fs-base);
  color: var(--danger);
  font-weight: 600;
}

.coupon-select {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.coupon-arrow {
  font-size: var(--fs-md);
  color: var(--text-hint);
}

.price-card {
  background: var(--white);
}

.price-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: var(--spacing-md);
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
}

.price-label {
  font-size: var(--fs-base);
  color: var(--text-body);
}

.price-value {
  font-size: var(--fs-base);
  color: var(--text-title);
}

.price-value.discount {
  color: var(--danger);
}

.price-divider {
  height: 1rpx;
  background: var(--divider);
  margin: var(--spacing-md) 0;
}

.total-row {
  padding-top: var(--spacing-md);
}

.total-label {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--text-title);
}

.total-price-wrap {
  display: flex;
  align-items: baseline;
}

.total-symbol {
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--express-primary);
}

.total-price {
  font-size: var(--fs-xxl);
  font-weight: 700;
  color: var(--express-primary);
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-md) var(--page-margin);
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xs);
  color: var(--white);
  background: var(--white);
}

.checkbox.checked {
  background: var(--express-primary);
  border-color: var(--express-primary);
}

.agreement-text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.agreement-link {
  font-size: var(--fs-sm);
  color: var(--express-primary);
}

.bottom-bar-placeholder {
  height: 200rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 1rpx solid var(--divider);
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bottom-bar-left {
  flex: 1;
}

.bottom-bar-label {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.bottom-bar-value {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--express-primary);
}

.btn-pay {
  min-width: 240rpx;
}

.btn-disabled {
  background: #C9CDD4 !important;
  box-shadow: none !important;
  color: #F2F3F5 !important;
}
