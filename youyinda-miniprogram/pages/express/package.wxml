<view class="container">
  <view class="page-header">
    <view class="header-title">物品信息</view>
    <view class="header-desc">请填写物品详细信息，便于准确计费</view>
  </view>

  <!-- 物品类型 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">物品类型</text>
      <text class="req">*</text>
    </view>
    <view class="option-group type-grid">
      <view class="opt type-opt {{itemType === '文件' ? 'active-express' : ''}}" bindtap="selectItemType">
        <icon name="file" size="{{36}}" color="{{itemType === '文件' ? '#0D9488' : '#94A3B8'}}" />
        <text class="type-name">文件</text>
      </view>
      <view class="opt type-opt {{itemType === '衣服' ? 'active-express' : ''}}" bindtap="selectItemType">
        <icon name="users" size="{{36}}" color="{{itemType === '衣服' ? '#0D9488' : '#94A3B8'}}" />
        <text class="type-name">衣服</text>
      </view>
      <view class="opt type-opt {{itemType === '食品' ? 'active-express' : ''}}" bindtap="selectItemType">
        <icon name="gift" size="{{36}}" color="{{itemType === '食品' ? '#0D9488' : '#94A3B8'}}" />
        <text class="type-name">食品</text>
      </view>
      <view class="opt type-opt {{itemType === '电子产品' ? 'active-express' : ''}}" bindtap="selectItemType">
        <icon name="zap" size="{{36}}" color="{{itemType === '电子产品' ? '#0D9488' : '#94A3B8'}}" />
        <text class="type-name">电子产品</text>
      </view>
      <view class="opt type-opt {{itemType === '其他' ? 'active-express' : ''}}" bindtap="selectItemType">
        <icon name="more" size="{{36}}" color="{{itemType === '其他' ? '#0D9488' : '#94A3B8'}}" />
        <text class="type-name">其他</text>
      </view>
    </view>
  </view>

  <!-- 物品名称 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">物品名称</text>
    </view>
    <input class="input" placeholder="如：合同文件、冬装等" value="{{itemName}}" bindinput="onItemNameInput" />
  </view>

  <!-- 物品重量 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">物品重量</text>
      <text class="req">*</text>
    </view>
    <view class="weight-row">
      <input class="weight-input" type="digit" placeholder="0.0" value="{{weight}}" bindinput="onWeightInput" />
      <text class="weight-unit">kg</text>
    </view>
    <view class="weight-tip">首重 1kg 内按起步价计算，超出部分按续重计费</view>
  </view>

  <!-- 物品描述 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">物品描述</text>
      <text class="opt-tip">选填</text>
    </view>
    <textarea class="desc-input" placeholder="请填写物品名称、数量等信息，便于快递员确认" value="{{remark}}" bindinput="onRemarkInput" maxlength="100" />
    <view class="char-count">{{remark.length}}/100</view>
  </view>

  <view class="bottom-bar-space"></view>
  <view class="bottom-bar">
    <button class="btn-primary btn-block btn-express" bindtap="goToCompany" disabled="{{!(itemType && weight)}}">
      下一步
    </button>
  </view>
</view>
