<view class="container">
  <view class="page-header">
    <view class="header-title">物品信息</view>
    <view class="header-desc">请填写物品详细信息，便于准确计费</view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">物品类型</text>
      <text class="card-required">*</text>
    </view>
    <view class="type-grid">
      <view class="type-item {{selectedType === item.value ? 'active' : ''}}" wx:for="{{goodsTypes}}" wx:key="value" bindtap="selectType" data-type="{{item.value}}">
        <text class="type-icon">{{item.icon}}</text>
        <text class="type-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">物品重量</text>
      <text class="card-required">*</text>
    </view>
    <view class="weight-section">
      <view class="weight-control">
        <view class="weight-btn" bindtap="decreaseWeight">
          <text>−</text>
        </view>
        <view class="weight-input-wrap">
          <input class="weight-input" type="digit" value="{{weight}}" bindinput="onWeightInput" />
          <text class="weight-unit">kg</text>
        </view>
        <view class="weight-btn" bindtap="increaseWeight">
          <text>+</text>
        </view>
      </view>
      <view class="weight-tips">
        <text>首重1kg内按起步价计算，超出部分按续重计费</text>
      </view>
      <view class="quick-weight">
        <view class="quick-tag {{weight === item ? 'active' : ''}}" wx:for="{{quickWeights}}" wx:key="*this" bindtap="setWeight" data-weight="{{item}}">
          {{item}}kg
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">物品描述</text>
      <text class="card-optional">选填</text>
    </view>
    <view class="input-wrap">
      <textarea class="desc-input" placeholder="请填写物品名称、数量等信息，便于快递员确认" value="{{remark}}" bindinput="onRemarkInput" maxlength="100" />
      <view class="char-count">{{remark.length}}/100</view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">保价服务</text>
    </view>
    <view class="insurance-row" bindtap="toggleInsurance">
      <view class="insurance-info">
        <view class="insurance-label">物品保价</view>
        <view class="insurance-desc">按保价金额的1%收取保价费，最高保价10000元</view>
      </view>
      <view class="insurance-value">
        <text wx:if="{{insuranceAmount > 0}}">¥{{insuranceAmount}}</text>
        <switch class="switch" checked="{{insuranceEnabled}}" color="#FF7D00" bindchange="onInsuranceChange" />
      </view>
    </view>
    <view wx:if="{{insuranceEnabled}}" class="insurance-input-wrap">
      <text class="insurance-prefix">¥</text>
      <input class="insurance-input" type="digit" placeholder="请输入保价金额" value="{{insuranceAmount}}" bindinput="onInsuranceAmountInput" />
    </view>
  </view>

  <view class="bottom-bar-placeholder"></view>

  <view class="bottom-bar">
    <view class="bottom-bar-left">
      <view class="bottom-bar-label">预估运费</view>
      <view class="bottom-bar-value">¥{{estimatedPrice}}</view>
    </view>
    <button class="btn-primary {{!(selectedType && weight) ? 'btn-disabled' : ''}}" bindtap="goToCompany" disabled="{{!(selectedType && weight)}}">
      选择快递
    </button>
  </view>
</view>
