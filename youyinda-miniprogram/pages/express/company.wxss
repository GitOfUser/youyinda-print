button::after {
  border: none;
}

.page-header {
  padding: var(--s-lg) var(--page-margin);
  padding-top: calc(var(--s-lg) + env(safe-area-inset-top));
  background: var(--express-gradient);
}

.header-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  margin-bottom: var(--s-xs);
}

.header-desc {
  font-size: var(--fs-sm);
  color: var(--white);
  opacity: 0.85;
}

.rs-card {
  margin-top: -24rpx;
  position: relative;
  z-index: 1;
}

.rs-route {
  display: flex;
  align-items: center;
  gap: var(--s-sm);
}

.rs-point {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.rs-city {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--t1);
}

.rs-tag {
  font-size: var(--fs-xs);
  color: var(--t3);
}

.rs-arrow {
  flex-shrink: 0;
}

.rs-goods {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: auto;
  padding-left: var(--s-md);
  border-left: 1rpx solid var(--line);
}

.rs-goods-text {
  font-size: var(--fs-sm);
  color: var(--t2);
  white-space: nowrap;
}

.company-list {
  padding: 0 var(--page-margin);
}

.company-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin-bottom: var(--s-md);
  padding: var(--s-lg);
  box-shadow: var(--shadow-card);
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
  overflow: hidden;
}

.company-card.selected {
  border-color: var(--express);
  box-shadow: var(--shadow-express);
}

.co-main {
  display: flex;
  align-items: flex-start;
  gap: var(--s-md);
}

.co-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--express-gradient);
  flex-shrink: 0;
}

.co-avatar-text {
  font-size: var(--fs-base);
  font-weight: 700;
  color: var(--white);
}

.co-info {
  flex: 1;
  min-width: 0;
}

.co-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
  margin-bottom: var(--s-xs);
}

.co-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-xs);
}

.co-price {
  text-align: right;
  flex-shrink: 0;
}

.price-cur {
  font-size: var(--fs-sm);
  color: var(--express);
}

.price-num {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--express);
  margin-left: 2rpx;
}

.co-check {
  position: absolute;
  top: var(--s-md);
  right: var(--s-md);
}
