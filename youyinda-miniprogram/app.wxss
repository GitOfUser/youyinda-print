/**
 * 优印达小程序 - 全局样式
 * 严格按照Stitch设计系统 - Warm Professionalism实现
 */

/* ==================== CSS变量定义 ==================== */
page {
  /* 快递主题 - 活力橙 */
  --express-primary: #FF7D00;
  --express-primary-light: #FFF3E8;
  --express-primary-dark: #E06E00;
  --express-gradient: linear-gradient(135deg, #FF7D00 0%, #FF9A3C 100%);
  --express-shadow: 0 4rpx 24rpx rgba(255,125,0,0.35);

  /* 打印主题 - 经典蓝 */
  --print-primary: #165DFF;
  --print-primary-light: #E8EDFF;
  --print-primary-dark: #096DD9;
  --print-gradient: linear-gradient(135deg, #165DFF 0%, #4080FF 100%);
  --print-shadow: 0 4rpx 24rpx rgba(22,93,255,0.3);

  /* 默认主色 (快递橙) */
  --primary: #FF7D00;
  --primary-light: #FFF3E8;
  --primary-dark: #E06E00;
  --primary-gradient: linear-gradient(135deg, #FF7D00 0%, #FF9A3C 100%);
  --primary-shadow: 0 4rpx 24rpx rgba(255,125,0,0.35);

  /* 语义色 */
  --success: #22C55E;
  --success-light: #E7F8EE;
  --danger: #EF4444;
  --danger-light: #FEE8E8;
  --info: #3B82F6;
  --info-light: #E8F1FF;
  --warning: #F59E0B;
  --warning-light: #FFF3E6;

  /* 品牌背景 - 暖米白 */
  --bg-cream: #F9F6F0;
  --bg-gray: #F2F3F5;

  /* 中性色 */
  --text-title: #1D2129;
  --text-body: #4E5969;
  --text-secondary: #86909C;
  --text-hint: #C9CDD4;
  --border: #E5E6EB;
  --divider: #EEEEEE;
  --white: #FFFFFF;

  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999px;

  /* 阴影 */
  --shadow-card: 0 2rpx 12rpx rgba(0,0,0,0.06);
  --shadow-primary: 0 4rpx 24rpx rgba(255,125,0,0.35);
  --shadow-print: 0 4rpx 24rpx rgba(22,93,255,0.3);
  --shadow-modal: 0 8rpx 32rpx rgba(0,0,0,0.12);
  --shadow-elevated: 0 8rpx 24rpx rgba(0,0,0,0.1);

  /* 字体尺寸 */
  --fs-xs: 20rpx;
  --fs-sm: 24rpx;
  --fs-base: 28rpx;
  --fs-md: 32rpx;
  --fs-lg: 36rpx;
  --fs-xl: 40rpx;
  --fs-xxl: 48rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --page-margin: 32rpx;

  /* 页面背景 */
  background-color: var(--bg-cream);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--text-title);
  font-size: var(--fs-base);
  line-height: 1.5;
}

/* ==================== 通用布局类 ==================== */
.container {
  min-height: 100vh;
  background-color: var(--bg-cream);
  padding-bottom: 180rpx;
}

.page-content {
  padding: var(--spacing-md) 0;
}

.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-around { display: flex; align-items: center; justify-content: space-around; }
.flex-start { display: flex; align-items: center; justify-content: flex-start; }
.flex-end { display: flex; align-items: center; justify-content: flex-end; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* ==================== 通用组件类 ==================== */
/* 主按钮 - 胶囊形状 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 48rpx;
  background: var(--primary-gradient);
  color: white;
  font-size: var(--fs-base);
  font-weight: 600;
  border-radius: var(--radius-full);
  border: none;
  box-shadow: var(--primary-shadow);
  min-width: 200rpx;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary[disabled] {
  background: #C9CDD4;
  box-shadow: none;
  color: #F2F3F5;
}

/* 打印主题按钮 */
.btn-print {
  background: var(--print-gradient);
  box-shadow: var(--print-shadow);
}

.btn-print[disabled] {
  background: #C9CDD4;
  box-shadow: none;
  color: #F2F3F5;
}

/* 快递主题按钮 */
.btn-express {
  background: var(--express-gradient);
  box-shadow: var(--express-shadow);
}

/* 次要按钮 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  background: white;
  color: var(--text-body);
  font-size: var(--fs-base);
  font-weight: 500;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--border);
}

.btn-secondary:active {
  background: var(--bg-gray);
}

/* 文字按钮 */
.btn-text {
  display: inline-flex;
  align-items: center;
  color: var(--primary);
  font-size: var(--fs-base);
  font-weight: 500;
  padding: 8rpx 16rpx;
}

.btn-text-print {
  color: var(--print-primary);
}

/* 小按钮 */
.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: var(--fs-sm);
  min-width: auto;
}

/* 块级按钮 */
.btn-block {
  width: 100%;
}

/* 卡片 */
.card {
  background: var(--white);
  border-radius: var(--radius-lg);
  margin: 0 var(--page-margin) var(--spacing-md);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.card-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-title);
}

.card-flat {
  background: var(--white);
  border-radius: var(--radius-lg);
  margin: 0 var(--page-margin) var(--spacing-md);
  padding: var(--spacing-lg);
}

.card-section {
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--divider);
}

.card-section:last-child {
  border-bottom: none;
}

/* 输入框 */
.input-group {
  margin-bottom: var(--spacing-md);
}

.input-label {
  font-size: var(--fs-sm);
  color: var(--text-body);
  margin-bottom: var(--spacing-sm);
  display: block;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: var(--radius-sm);
  padding: 0 var(--spacing-md);
  font-size: var(--fs-base);
  color: var(--text-title);
  background: var(--bg-gray);
  box-sizing: border-box;
}

.input:focus {
  background: var(--white);
  box-shadow: 0 0 0 2rpx var(--primary-light);
}

.input::placeholder {
  color: var(--text-hint);
}

.input-error {
  box-shadow: 0 0 0 2rpx var(--danger-light);
}

.error-text {
  font-size: var(--fs-xs);
  color: var(--danger);
  margin-top: var(--spacing-xs);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-xs);
  font-size: var(--fs-xs);
  font-weight: 500;
  line-height: 1.4;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-print {
  background: var(--print-primary-light);
  color: var(--print-primary);
}

.tag-success {
  background: var(--success-light);
  color: var(--success);
}

.tag-danger {
  background: var(--danger-light);
  color: var(--danger);
}

.tag-info {
  background: var(--info-light);
  color: var(--info);
}

.tag-warning {
  background: var(--warning-light);
  color: var(--warning);
}

.tag-gray {
  background: #F3F4F6;
  color: #86909C;
}

/* 选项组 */
.option-group {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

.option-item {
  flex: 1;
  min-width: 0;
  padding: var(--spacing-md);
  text-align: center;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: var(--fs-base);
  color: var(--text-body);
  background: var(--white);
  transition: all 0.2s ease;
}

.option-item.active {
  border-color: var(--primary);
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.option-item.print-active {
  border-color: var(--print-primary);
  background: var(--print-primary-light);
  color: var(--print-primary);
}

/* 分隔线 */
.divider {
  height: var(--spacing-sm);
  background: var(--bg-cream);
}

.line {
  height: 1rpx;
  background: var(--divider);
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--divider);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content { flex: 1; }
.list-item-arrow { color: var(--text-hint); font-size: var(--fs-md); }

/* ==================== 文字样式类 ==================== */
.text-title { font-size: var(--fs-xl); font-weight: 700; color: var(--text-title); line-height: 1.4; }
.text-lg { font-size: var(--fs-lg); font-weight: 600; color: var(--text-title); }
.text-md { font-size: var(--fs-md); font-weight: 600; color: var(--text-title); }
.text-base { font-size: var(--fs-base); color: var(--text-body); }
.text-sm { font-size: var(--fs-sm); color: var(--text-secondary); }
.text-xs { font-size: var(--fs-xs); color: var(--text-hint); }

.text-primary { color: var(--primary); }
.text-print { color: var(--print-primary); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-info { color: var(--info); }
.text-warning { color: var(--warning); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-bold { font-weight: 600; }

.text-price {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--primary);
}

.text-price-print { color: var(--print-primary); }

.text-price-lg {
  font-size: var(--fs-xxl);
  font-weight: 700;
}

/* ==================== 间距类 ==================== */
.m-0 { margin: 0; }
.m-xs { margin: var(--spacing-xs); }
.m-sm { margin: var(--spacing-sm); }
.m-md { margin: var(--spacing-md); }
.m-lg { margin: var(--spacing-lg); }
.m-xl { margin: var(--spacing-xl); }
.mt-0 { margin-top: 0; }
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mb-0 { margin-bottom: 0; }
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }
.ml-xs { margin-left: var(--spacing-xs); }
.ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }
.mr-xs { margin-right: var(--spacing-xs); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }
.p-0 { padding: 0; }
.p-xs { padding: var(--spacing-xs); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }
.pt-0 { padding-top: 0; }
.pt-xs { padding-top: var(--spacing-xs); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }
.pb-0 { padding-bottom: 0; }
.pb-xs { padding-bottom: var(--spacing-xs); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }
.pl-xs { padding-left: var(--spacing-xs); }
.pl-sm { padding-left: var(--spacing-sm); }
.pl-md { padding-left: var(--spacing-md); }
.pr-xs { padding-right: var(--spacing-xs); }
.pr-sm { padding-right: var(--spacing-sm); }
.pr-md { padding-right: var(--spacing-md); }
.px-md { padding-left: var(--spacing-md); padding-right: var(--spacing-md); }
.py-md { padding-top: var(--spacing-md); padding-bottom: var(--spacing-md); }
.py-sm { padding-top: var(--spacing-sm); padding-bottom: var(--spacing-sm); }

/* 页面边距 */
.page-margin {
  padding-left: var(--page-margin);
  padding-right: var(--page-margin);
}

/* ==================== 底部固定栏 ==================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 1rpx solid var(--divider);
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bottom-bar-left { flex: 1; }

.bottom-bar-price {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
}

.bottom-bar-label {
  font-size: var(--fs-sm);
  color: var(--text-body);
}

.bottom-bar-value {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--primary);
}

.bottom-bar-placeholder {
  height: 180rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  font-size: var(--fs-base);
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

.empty-desc {
  font-size: var(--fs-sm);
  color: var(--text-hint);
  text-align: center;
}

.empty-btn {
  margin-top: var(--spacing-lg);
  padding: var(--spacing-sm) var(--spacing-xl);
  background: var(--primary-gradient);
  color: white;
  font-size: var(--fs-base);
  font-weight: 500;
  border-radius: var(--radius-full);
  box-shadow: var(--primary-shadow);
}

/* ==================== 数量控制器 ==================== */
.quantity-control {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-gray);
  border-radius: 50%;
  font-size: var(--fs-lg);
  color: var(--text-body);
}

.quantity-btn:active { background: var(--border); }

.quantity-value {
  font-size: var(--fs-lg);
  color: var(--text-title);
  font-weight: 600;
  min-width: 80rpx;
  text-align: center;
}

/* ==================== 头像 ==================== */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-gray);
}

.avatar-sm { width: 64rpx; height: 64rpx; }
.avatar-lg { width: 140rpx; height: 140rpx; }

/* ==================== 图标容器 ==================== */
.icon-box {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: 44rpx;
}

.icon-box-sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 32rpx;
  border-radius: var(--radius-md);
}

.icon-box-primary { background: var(--primary-light); color: var(--primary); }
.icon-box-print { background: var(--print-primary-light); color: var(--print-primary); }

/* ==================== 加载状态 ==================== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(249,246,240,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-md);
}

/* ==================== 安全区域适配 ==================== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 圆角工具类 ==================== */
.rounded-sm { border-radius: var(--radius-sm); }
.rounded-md { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-full { border-radius: var(--radius-full); }

/* ==================== 阴影工具类 ==================== */
.shadow-sm { box-shadow: var(--shadow-card); }
.shadow-md { box-shadow: var(--shadow-elevated); }
.shadow-lg { box-shadow: var(--shadow-modal); }

/* ==================== 背景工具类 ==================== */
.bg-white { background: var(--white); }
.bg-gray { background: var(--bg-gray); }
.bg-primary { background: var(--primary); }
.bg-cream { background: var(--bg-cream); }

/* ==================== 宽度工具类 ==================== */
.w-full { width: 100%; }
.w-auto { width: auto; }

/* ==================== 显示工具类 ==================== */
.block { display: block; }
.inline-block { display: inline-block; }
.hidden { display: none; }
.overflow-hidden { overflow: hidden; }

/* ==================== 隐藏滚动条 ==================== */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}
