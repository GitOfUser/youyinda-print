/**
 * 优印达小程序 - 全局样式 v2
 * 设计方向：现代清透风（品牌蓝紫 #4F46E5 / 快递青绿 #0D9488）
 * 规范文档：docs/miniprogram-redesign-v2-spec.md
 */

/* ==================== 设计令牌 ==================== */
page {
  /* 品牌 - 蓝紫 */
  --brand: #4F46E5;
  --brand-dark: #4338CA;
  --brand-light: #EEF0FF;
  --brand-gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  --brand-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.35);

  /* 打印服务线（同品牌蓝紫） */
  --print: #4F46E5;
  --print-light: #EEF0FF;
  --print-gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  --print-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.35);

  /* 快递服务线 - 青绿 */
  --express: #0D9488;
  --express-light: #E6F7F4;
  --express-gradient: linear-gradient(135deg, #14B8A6 0%, #2DD4BF 100%);
  --express-shadow: 0 8rpx 24rpx rgba(20, 184, 166, 0.30);

  /* 主色别名（默认品牌色） */
  --primary: #4F46E5;
  --primary-light: #EEF0FF;
  --primary-dark: #4338CA;
  --primary-gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  --primary-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.35);

  /* 语义色 */
  --success: #10B981;
  --success-light: #E8F8F1;
  --info: #3B82F6;
  --info-light: #EBF2FE;
  --warning: #F59E0B;
  --warning-light: #FEF5E4;
  --danger: #EF4444;
  --danger-light: #FDEBEB;

  /* 中性色 */
  --bg: #F5F6FA;
  --card: #FFFFFF;
  --t1: #0F172A;
  --t2: #475569;
  --t3: #94A3B8;
  --line: #EEF0F4;
  --border: #E5E8F0;
  --fill: #F7F8FB;

  /* 兼容旧变量名 */
  --bg-cream: #F5F6FA;
  --bg-gray: #F7F8FB;
  --text-title: #0F172A;
  --text-body: #475569;
  --text-secondary: #94A3B8;
  --text-hint: #C3C9D4;
  --divider: #EEF0F4;
  --white: #FFFFFF;

  /* 圆角 */
  --r-xs: 10rpx;
  --r-sm: 16rpx;
  --r-md: 20rpx;
  --r-lg: 24rpx;
  --r-full: 999px;
  --radius-xs: 10rpx;
  --radius-sm: 16rpx;
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --radius-full: 999px;

  /* 阴影 */
  --shadow-card: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
  --shadow-primary: 0 8rpx 24rpx rgba(99, 102, 241, 0.35);
  --shadow-print: 0 8rpx 24rpx rgba(99, 102, 241, 0.35);
  --shadow-express: 0 8rpx 24rpx rgba(20, 184, 166, 0.30);
  --shadow-bar: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  --shadow-modal: 0 12rpx 40rpx rgba(15, 23, 42, 0.14);
  --shadow-elevated: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);

  /* 字号 */
  --fs-xs: 20rpx;
  --fs-sm: 24rpx;
  --fs-base: 28rpx;
  --fs-md: 32rpx;
  --fs-lg: 36rpx;
  --fs-xl: 44rpx;
  --fs-xxl: 52rpx;

  /* 间距 */
  --s-xs: 8rpx;
  --s-sm: 16rpx;
  --s-md: 24rpx;
  --s-lg: 32rpx;
  --s-xl: 48rpx;
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --page-margin: 32rpx;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--t1);
  font-size: var(--fs-base);
  line-height: 1.5;
}

/* ==================== 布局工具 ==================== */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 40rpx;
}

.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-around { display: flex; align-items: center; justify-content: space-around; }
.flex-start { display: flex; align-items: center; justify-content: flex-start; }
.flex-end { display: flex; align-items: center; justify-content: flex-end; }
.flex-1 { flex: 1; min-width: 0; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* ==================== 卡片 ==================== */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: 0 var(--page-margin) var(--s-md);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.card-flat {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: 0 var(--page-margin) var(--s-md);
  padding: 32rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s-md);
}

.card-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--t1);
}

.card-section {
  padding: var(--s-md) 0;
  border-bottom: 1rpx solid var(--line);
}
.card-section:last-child { border-bottom: none; }

/* 区块标题（卡片外） */
.section-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--t1);
  margin: 40rpx var(--page-margin) 20rpx;
  letter-spacing: 0.5rpx;
}

/* ==================== 按钮 ==================== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 48rpx;
  background: var(--brand-gradient);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--r-full);
  border: none;
  box-shadow: var(--brand-shadow);
  min-width: 220rpx;
  letter-spacing: 1rpx;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-primary[disabled] {
  background: #D8DCE6;
  box-shadow: none;
  color: #FFFFFF;
}

.btn-print { background: var(--print-gradient); box-shadow: var(--print-shadow); }
.btn-express { background: var(--express-gradient); box-shadow: var(--express-shadow); }

.btn-print[disabled], .btn-express[disabled] {
  background: #D8DCE6;
  box-shadow: none;
  color: #FFFFFF;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  background: var(--card);
  color: var(--t2);
  font-size: var(--fs-base);
  font-weight: 500;
  border-radius: var(--r-full);
  border: 1.5rpx solid var(--border);
}
.btn-ghost:active { background: var(--fill); }

/* 兼容旧命名 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  background: var(--card);
  color: var(--t2);
  font-size: var(--fs-base);
  font-weight: 500;
  border-radius: var(--r-full);
  border: 1.5rpx solid var(--border);
}
.btn-secondary:active { background: var(--fill); }

.btn-text {
  display: inline-flex;
  align-items: center;
  color: var(--brand);
  font-size: var(--fs-base);
  font-weight: 500;
  padding: 8rpx 16rpx;
}
.btn-text-print { color: var(--print); }

.btn-sm { height: 64rpx; padding: 0 28rpx; font-size: var(--fs-sm); min-width: auto; }
.btn-block { width: 100%; }

/* ==================== 表单 ==================== */
.input-group { margin-bottom: var(--s-md); }

.input-label {
  font-size: var(--fs-sm);
  color: var(--t2);
  margin-bottom: var(--s-sm);
  display: block;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 96rpx;
  border: none;
  border-radius: var(--r-sm);
  padding: 0 var(--s-md);
  font-size: var(--fs-base);
  color: var(--t1);
  background: var(--fill);
  box-sizing: border-box;
}
.input::placeholder { color: var(--t3); }

.input-error { box-shadow: 0 0 0 2rpx var(--danger); }

.error-text {
  font-size: var(--fs-xs);
  color: var(--danger);
  margin-top: var(--s-xs);
}

.field { width: 100%; height: 96rpx; border-radius: var(--r-sm); padding: 0 var(--s-md); background: var(--fill); font-size: var(--fs-base); color: var(--t1); box-sizing: border-box; }
.field-label { font-size: var(--fs-sm); color: var(--t2); font-weight: 500; margin-bottom: var(--s-sm); display: block; }

/* ==================== 标签 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--r-xs);
  font-size: var(--fs-xs);
  font-weight: 500;
  line-height: 1.5;
}

.tag-primary { background: var(--brand-light); color: var(--brand); }
.tag-print { background: var(--print-light); color: var(--print); }
.tag-express { background: var(--express-light); color: var(--express); }
.tag-success { background: var(--success-light); color: var(--success); }
.tag-danger { background: var(--danger-light); color: var(--danger); }
.tag-info { background: var(--info-light); color: var(--info); }
.tag-warning { background: var(--warning-light); color: var(--warning); }
.tag-gray { background: #F1F3F7; color: var(--t3); }

/* 状态标签（订单状态，带小圆点） */
.st {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-xs);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
}
.st::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}
.st-warning { background: var(--warning-light); color: var(--warning); }
.st-info { background: var(--info-light); color: var(--info); }
.st-success { background: var(--success-light); color: var(--success); }
.st-gray { background: #F1F3F7; color: var(--t3); }

/* ==================== 选项组 ==================== */
.option-group { display: flex; gap: var(--s-sm); flex-wrap: wrap; }

.opt {
  flex: 1;
  min-width: 0;
  padding: 22rpx var(--s-sm);
  text-align: center;
  border: 1.5rpx solid var(--border);
  border-radius: var(--r-md);
  font-size: var(--fs-base);
  color: var(--t2);
  background: var(--card);
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.opt.active {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
}

.opt.active-express {
  border-color: var(--express);
  background: var(--express-light);
  color: var(--express);
  font-weight: 600;
}

/* 兼容旧类名 */
.option-item {
  flex: 1;
  min-width: 0;
  padding: 22rpx var(--s-sm);
  text-align: center;
  border: 1.5rpx solid var(--border);
  border-radius: var(--r-md);
  font-size: var(--fs-base);
  color: var(--t2);
  background: var(--card);
  transition: all 0.2s ease;
  box-sizing: border-box;
}
.option-item.active { border-color: var(--brand); background: var(--brand-light); color: var(--brand); font-weight: 600; }
.option-item.print-active { border-color: var(--print); background: var(--print-light); color: var(--print); font-weight: 600; }

/* ==================== 图标容器 ==================== */
.icon-tile {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  flex-shrink: 0;
}

.icon-tile-sm {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.tile-brand { background: var(--brand-light); }
.tile-print { background: var(--print-light); }
.tile-express { background: var(--express-light); }
.tile-orange { background: var(--warning-light); }
.tile-red { background: var(--danger-light); }
.tile-blue { background: var(--info-light); }
.tile-green { background: var(--success-light); }
.tile-gray { background: #F1F3F7; }

/* 渐变图标容器（首页主入口等强调场景） */
.icon-tile-grad-brand { background: var(--brand-gradient); box-shadow: var(--brand-shadow); }
.icon-tile-grad-express { background: var(--express-gradient); box-shadow: var(--express-shadow); }

/* 兼容旧类 */
.icon-box { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-lg); }
.icon-box-sm { width: 72rpx; height: 72rpx; border-radius: 18rpx; }
.icon-box-primary { background: var(--brand-light); }
.icon-box-print { background: var(--print-light); }

/* ==================== 分割线 ==================== */
.divider { height: var(--s-sm); background: var(--bg); }
.line { height: 1rpx; background: var(--line); }

/* ==================== 列表 ==================== */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.list-item:last-child { border-bottom: none; }
.list-item-content { flex: 1; min-width: 0; }
.list-item-arrow { color: var(--t3); }

/* ==================== 文字 ==================== */
.text-title { font-size: var(--fs-xl); font-weight: 700; color: var(--t1); line-height: 1.4; }
.text-lg { font-size: var(--fs-lg); font-weight: 600; color: var(--t1); }
.text-md { font-size: var(--fs-md); font-weight: 600; color: var(--t1); }
.text-base { font-size: var(--fs-base); color: var(--t2); }
.text-sm { font-size: var(--fs-sm); color: var(--t3); }
.text-xs { font-size: var(--fs-xs); color: var(--t3); }

.text-primary { color: var(--brand); }
.text-print { color: var(--print); }
.text-express { color: var(--express); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-info { color: var(--info); }
.text-warning { color: var(--warning); }
.text-secondary { color: var(--t2); }
.text-hint { color: var(--t3); }
.text-bold { font-weight: 600; }

.text-price { font-size: var(--fs-lg); font-weight: 700; color: var(--brand); }
.text-price-print { color: var(--print); }
.text-price-lg { font-size: var(--fs-xxl); font-weight: 700; }

/* ==================== 底部固定栏 ==================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-md);
  padding: 20rpx var(--s-lg);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: var(--shadow-bar);
  z-index: 100;
}

.bottom-bar-left { flex: 1; min-width: 0; }

.bottom-bar-price { display: flex; align-items: baseline; gap: 4rpx; }

.bottom-bar-label { font-size: var(--fs-sm); color: var(--t2); }

.bottom-bar-value { font-size: 40rpx; font-weight: 700; color: var(--brand); }

.bottom-bar-placeholder { height: 180rpx; padding-bottom: env(safe-area-inset-bottom); }
.bottom-bar-space { height: 180rpx; padding-bottom: env(safe-area-inset-bottom); }

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-text {
  font-size: var(--fs-base);
  color: var(--t3);
  text-align: center;
  margin-top: var(--s-md);
}

.empty-desc { font-size: var(--fs-sm); color: var(--t3); text-align: center; margin-top: 8rpx; }

.empty-btn {
  margin-top: var(--s-lg);
  padding: 18rpx 56rpx;
  background: var(--card);
  color: var(--brand);
  border: 1.5rpx solid var(--brand);
  font-size: var(--fs-base);
  font-weight: 500;
  border-radius: var(--r-full);
}

/* 兼容旧类 */
.empty-icon { opacity: 0.5; }
.empty-image { width: 240rpx; height: 240rpx; margin-bottom: var(--s-md); }

/* ==================== 数量控制器 ==================== */
.quantity-control { display: flex; align-items: center; gap: var(--s-md); }

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fill);
  border-radius: 50%;
  color: var(--t2);
}
.quantity-btn:active { background: var(--border); }

.quantity-btn.brand { background: var(--brand-light); color: var(--brand); }

.quantity-value {
  font-size: var(--fs-md);
  color: var(--t1);
  font-weight: 600;
  min-width: 72rpx;
  text-align: center;
}

/* ==================== 头像 ==================== */
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; overflow: hidden; background: var(--fill); }
.avatar-sm { width: 64rpx; height: 64rpx; }
.avatar-lg { width: 140rpx; height: 140rpx; }

/* ==================== 加载 ==================== */
.loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(245, 246, 250, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-text { font-size: var(--fs-sm); color: var(--t3); margin-top: var(--s-md); }

/* ==================== 通用工具类 ==================== */
.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }

.rounded-sm { border-radius: var(--r-sm); }
.rounded-md { border-radius: var(--r-md); }
.rounded-lg { border-radius: var(--r-lg); }
.rounded-full { border-radius: var(--r-full); }

.shadow-sm { box-shadow: var(--shadow-card); }
.shadow-md { box-shadow: var(--shadow-elevated); }
.shadow-lg { box-shadow: var(--shadow-modal); }

.bg-white { background: var(--card); }
.bg-gray { background: var(--fill); }
.bg-primary { background: var(--brand); }
.bg-cream { background: var(--bg); }

.w-full { width: 100%; }
.w-auto { width: auto; }

.block { display: block; }
.inline-block { display: inline-block; }
.hidden { display: none; }
.overflow-hidden { overflow: hidden; }

.page-margin { padding-left: var(--page-margin); padding-right: var(--page-margin); }

/* 间距工具类 */
.m-0 { margin: 0; }
.m-xs { margin: var(--s-xs); }
.m-sm { margin: var(--s-sm); }
.m-md { margin: var(--s-md); }
.m-lg { margin: var(--s-lg); }
.m-xl { margin: var(--s-xl); }
.mt-0 { margin-top: 0; }
.mt-xs { margin-top: var(--s-xs); }
.mt-sm { margin-top: var(--s-sm); }
.mt-md { margin-top: var(--s-md); }
.mt-lg { margin-top: var(--s-lg); }
.mt-xl { margin-top: var(--s-xl); }
.mb-0 { margin-bottom: 0; }
.mb-xs { margin-bottom: var(--s-xs); }
.mb-sm { margin-bottom: var(--s-sm); }
.mb-md { margin-bottom: var(--s-md); }
.mb-lg { margin-bottom: var(--s-lg); }
.mb-xl { margin-bottom: var(--s-xl); }
.ml-xs { margin-left: var(--s-xs); }
.ml-sm { margin-left: var(--s-sm); }
.ml-md { margin-left: var(--s-md); }
.mr-xs { margin-right: var(--s-xs); }
.mr-sm { margin-right: var(--s-sm); }
.mr-md { margin-right: var(--s-md); }
.p-0 { padding: 0; }
.p-xs { padding: var(--s-xs); }
.p-sm { padding: var(--s-sm); }
.p-md { padding: var(--s-md); }
.p-lg { padding: var(--s-lg); }
.p-xl { padding: var(--s-xl); }
.pt-0 { padding-top: 0; }
.pt-xs { padding-top: var(--s-xs); }
.pt-sm { padding-top: var(--s-sm); }
.pt-md { padding-top: var(--s-md); }
.pt-lg { padding-top: var(--s-lg); }
.pb-0 { padding-bottom: 0; }
.pb-xs { padding-bottom: var(--s-xs); }
.pb-sm { padding-bottom: var(--s-sm); }
.pb-md { padding-bottom: var(--s-md); }
.pb-lg { padding-bottom: var(--s-lg); }
.pl-xs { padding-left: var(--s-xs); }
.pl-sm { padding-left: var(--s-sm); }
.pl-md { padding-left: var(--s-md); }
.pr-xs { padding-right: var(--s-xs); }
.pr-sm { padding-right: var(--s-sm); }
.pr-md { padding-right: var(--s-md); }
.px-md { padding-left: var(--s-md); padding-right: var(--s-md); }
.py-md { padding-top: var(--s-md); padding-bottom: var(--s-md); }
.py-sm { padding-top: var(--s-sm); padding-bottom: var(--s-sm); }

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}
